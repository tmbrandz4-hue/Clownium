{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/account", "destination": "/customer/dashboard", "statusCode": 308 },
    { "source": "/about", "destination": "/", "statusCode": 308 },
    { "source": "/features", "destination": "/#shop", "statusCode": 308 },
    { "source": "/terms", "destination": "/terms-of-service", "statusCode": 308 }
  ]
}
