<div class="ticket" x-data="ticket()">
  <div class="container component" data-component-id="{{ componentId }}">
    <section class="py-5-nav">

      <div class="mb-4">
        <h1 class="fw-bold mb-0" style="font-size:1.75rem">My Account</h1>
        <small style="color:#9ab0cf">{{ shop_customer.email }}</small>
      </div>

      <div class="row">
        <div class="col-12 col-lg-3 mb-4">
          {% render_snippet "customer-sidebar.njk" %}
        </div>
        <div class="col-12 col-lg-9">

          <a href="{{ '/customer/tickets' | shopUrl }}" class="cl-dash-btn-outline btn btn-sm mb-3 d-inline-flex">
            <i class="fa fa-arrow-left me-1"></i>Back to Tickets
          </a>

          <div class="cl-dash-card p-4 mb-3">
            <h5 class="fw-semibold mb-2">{{ ticket.subject }}</h5>
            <div class="d-flex flex-wrap gap-2">
              <span class="badge bg-secondary">Opened {{ ticket.created_at | formatDate }}</span>
              {% if ticket.invoice %}
                <a href="{{ ticket.invoice.url }}" target="_blank" class="badge bg-light text-dark text-decoration-none">
                  Invoice #{{ ticket.invoice.unique_id }}
                </a>
              {% endif %}
              <span class="badge"
                :class="{'bg-warning text-dark':ticket.status==='pending','bg-primary':ticket.status==='open','bg-success':ticket.status==='closed'}"
                x-text="ticket.status==='pending'?'Awaiting Your Response':ticket.status==='open'?'Awaiting Support Response':'Closed'">
                {% if ticket.status == 'pending' %}Awaiting Your Response
                {% elif ticket.status == 'open' %}Awaiting Support Response
                {% else %}Closed{% endif %}
              </span>
            </div>
          </div>

          <div class="cl-dash-card mb-3" style="overflow:hidden">
            <div class="ticket-messages-scroll" x-ref="messagesContainer" style="max-height:420px;overflow-y:auto;padding:1.25rem">
              <template x-for="message in ticket.messages" :key="message.id">
                <div class="mb-3">
                  <div class="d-flex gap-3" :class="{'flex-row-reverse':message.sender_type==='shop_customer'}">
                    <div style="width:36px;height:36px;flex:0 0 36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.875rem"
                      :style="message.sender_type==='shop_customer'?'background:rgba(59,130,246,.2);color:#3b82f6':'background:rgba(34,197,94,.2);color:#22c55e'">
                      <i :class="message.sender_type==='shop_customer'?'fa fa-user':'fa fa-headset'"></i>
                    </div>
                    <div class="flex-grow-1" :class="{'text-end':message.sender_type==='shop_customer'}">
                      <div class="d-flex align-items-center gap-2 mb-1" :class="{'flex-row-reverse':message.sender_type==='shop_customer'}">
                        <span class="fw-semibold" style="font-size:.875rem"
                          :style="message.sender_type==='shop_customer'?'color:#3b82f6':'color:#e6efff'"
                          x-text="message.sender_type==='shop_customer'?'You':'Support'"></span>
                        <span style="font-size:.75rem;color:#6f8bb8" x-text="getTimeAgo(message.created_at)"></span>
                      </div>
                      <div style="display:inline-block;padding:.6rem .9rem;border-radius:12px;font-size:.875rem;max-width:480px;text-align:left;word-break:break-word"
                        :style="message.sender_type==='shop_customer'?'background:rgba(59,130,246,.18);color:#e6efff':'background:rgba(255,255,255,.06);color:#e6efff'"
                        x-html="message.content"></div>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div style="border-top:1px solid rgba(120,180,255,.12);padding:1rem">
              <template x-if="ticket.status !== 'closed'">
                <form @submit.prevent="sendMessage()">
                  <div class="d-flex gap-2 align-items-end">
                    <textarea
                      x-model="formMessage"
                      placeholder="Reply to ticket…"
                      maxlength="8192"
                      rows="2"
                      class="form-control cl-textarea"
                      :disabled="isSubmitting"
                      @keydown="if($event.key==='Enter'&&!$event.shiftKey){$event.preventDefault();sendMessage()}"
                    ></textarea>
                    <button type="submit" class="cl-dash-btn" :disabled="isSubmitting">
                      <span x-show="!isSubmitting"><i class="fa fa-paper-plane"></i></span>
                      <span x-show="isSubmitting"><i class="fa fa-circle-notch fa-spin"></i></span>
                    </button>
                  </div>
                  <p x-show="formError" class="text-danger small mt-1 mb-0" x-text="formError"></p>
                </form>
              </template>
              <template x-if="ticket.status === 'closed'">
                <p class="text-center mb-0" style="color:#9ab0cf;font-size:.875rem">This ticket is closed.</p>
              </template>
            </div>
          </div>

        </div>
      </div>
    </section>
  </div>
</div>

<div class="components">
  {% for componentId in components_order %}
    {% render_component componentId %}
  {% endfor %}
</div>

<script>
document.addEventListener('alpine:init', () => {
  Alpine.data('ticket', () => ({
    ticket: {{ ticket | json }},
    formMessage: '',
    formError: '',
    isSubmitting: false,

    init() {
      this.scrollToBottom();
      setInterval(() => this.fetchTicket(), 10000);
    },

    scrollToBottom() {
      this.$nextTick(() => {
        if (this.$refs.messagesContainer)
          this.$refs.messagesContainer.scrollTop = this.$refs.messagesContainer.scrollHeight;
      });
    },

    getTimeAgo(input) {
      const date = new Date(input);
      const fmt = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
      const ranges = { year:31536000, month:2592000, week:604800, day:86400, hour:3600, minute:60, second:1 };
      const s = (date.getTime() - Date.now()) / 1000;
      for (const [k, n] of Object.entries(ranges)) {
        if (Math.abs(s) >= n) return fmt.format(Math.round(s / n), k);
      }
      return 'just now';
    },

    async fetchTicket() {
      const token = Cookies.get('shop_customer_token');
      try {
        const r = await fetch(`{{ ('/v1/customer-dashboard/tickets/' ~ ticket.id) | apiInternalUrl }}`, {
          headers: { 'Accept':'application/json', 'Authorization':`Bearer ${token}`, 'Content-Type':'application/json' }
        });
        if (!r.ok) throw new Error();
        this.ticket = await r.json();
        this.scrollToBottom();
      } catch {}
    },

    async sendMessage() {
      if (!this.formMessage.trim()) { this.formError = 'Message is required.'; return; }
      this.isSubmitting = true; this.formError = '';
      const token = Cookies.get('shop_customer_token');
      try {
        const r = await fetch(`{{ ('/v1/customer-dashboard/tickets/' ~ ticket.id ~ '/messages') | apiInternalUrl }}`, {
          method: 'POST',
          headers: { 'Accept':'application/json', 'Authorization':`Bearer ${token}`, 'Content-Type':'application/json' },
          body: JSON.stringify({ content: this.formMessage })
        });
        if (r.status === 429) throw new Error('Sending too quickly.');
        if (!r.ok) { const d = await r.json(); throw new Error(d.message || 'Failed to send'); }
        this.formMessage = '';
        await this.fetchTicket();
      } catch (e) {
        this.formError = String(e);
      } finally {
        this.isSubmitting = false;
      }
    },

    handleEnterKey(e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); this.sendMessage(); }
    }
  }));
});
</script>
