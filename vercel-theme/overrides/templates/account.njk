<section class="container component py-5-nav" style="min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center">
  <div class="cl-dash-card p-4 p-md-5" style="max-width:680px;width:100%">
    <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;border-radius:16px;background:rgba(59,130,246,.14);color:#60a5fa">
      <i class="fa fa-user" style="font-size:1.6rem"></i>
    </div>
    <h1 class="fw-bold mb-2">Redirecting to My Account</h1>
    <p style="color:#9ab0cf" class="mb-4">
      We’re sending you to the hosted customer dashboard.
    </p>
    <a class="btn cl-dash-btn" href="https://clownium.mysellauth.com/customer/dashboard">Open My Account</a>
  </div>
</section>

<script>
(function () {
  var target = 'https://clownium.mysellauth.com/customer/dashboard';
  try {
    window.location.replace(target);
  } catch (_) {
    window.location.href = target;
  }
})();
</script>

