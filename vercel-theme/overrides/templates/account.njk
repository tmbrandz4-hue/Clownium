<script>
(function () {
  // Set afterLoginPath based on the ?back= param so login returns to the right tab
  var params = new URLSearchParams(window.location.search);
  var back = params.get('back') || 'dashboard';
  var dest = back === 'invoices' ? '/customer/invoices'
           : back === 'tickets'  ? '/customer/tickets'
           : '/customer/dashboard';
  var openAfterDiscord = params.get('discord') === 'linked';
  var t = setInterval(function () {
    if (window.alpineApp && window.alpineApp.appCustomer) {
      window.alpineApp.appCustomer.afterLoginPath = dest;
      if (openAfterDiscord) {
        window.alpineApp.appCustomer.modalStep = 1;
        var modal = document.getElementById('customer-login-modal');
        if (modal && typeof bootstrap !== 'undefined') bootstrap.Modal.getOrCreateInstance(modal).show();
        openAfterDiscord = false;
      }
      clearInterval(t);
    }
  }, 50);

  // Reset captcha when login modal is dismissed
  document.addEventListener('hidden.bs.modal', function (ev) {
    if (!ev.target || ev.target.id !== 'customer-login-modal') return;
    window.dispatchEvent(new CustomEvent('cl-reset', { detail: null }));
  });
})();

// Reset captcha after failed OTP send
document.addEventListener('alpine:initialized', function () {
  var app = window.alpineApp;
  if (!app || !app.appCustomer) return;
  var orig = app.appCustomer.modalRequestOtp.bind(app.appCustomer);
  app.appCustomer.modalRequestOtp = async function () {
    await orig();
    if (app.appCustomer.modalStep === 1) {
      app.appCustomer.altchaPayload = null;
      window.dispatchEvent(new CustomEvent('cl-reset', { detail: null }));
    }
  };
});

document.addEventListener('alpine:init', () => {
  Alpine.data('clDashboard', () => ({
    loggedIn: false,
    token: null,
    loading: false,
    error: '',
    customer: null,
    latestOrder: null,
    orders: null,
    ordersPage: 1,
    tickets: null,
    activeTicket: null,
    loginEmail: '',
    discordLinked: false,
    discordUser: null,
    ticketReply: '',
    ticketSending: false,
    ticketError: '',
    ticketPollTimer: null,
    tab: 'dashboard',
    deletingAccount: false,

    init() {
      // Set tab from URL path
      const p = window.location.pathname;
      if (p.includes('/customer/invoices')) this.tab = 'orders';
      else if (p.includes('/customer/tickets')) this.tab = 'tickets';
      else this.tab = 'dashboard';

      this.token = this.getToken();
      this.refreshDiscord();
      if (this.token) {
        this.loggedIn = true;
        this.loadForTab();
      }
      window.addEventListener('cl:login', () => {
        try {
          this.loginEmail = (window.alpineApp && window.alpineApp.appCustomer && window.alpineApp.appCustomer.modalEmail) || this.loginEmail;
        } catch {}
        this.token = this.getToken();
        if (this.token) { this.loggedIn = true; this.loadForTab(); }
      });
    },

    loadForTab() {
      if (this.tab === 'dashboard') this.loadDashboard();
      else if (this.tab === 'orders') this.loadOrders(1);
      else if (this.tab === 'tickets') this.loadTickets(1);
    },

    getToken() {
      return (typeof Cookies !== 'undefined' ? Cookies.get('shop_customer_token') : null) || null;
    },

    openLoginModal() {
      const modal = document.getElementById('customer-login-modal');
      if (modal && typeof bootstrap !== 'undefined') bootstrap.Modal.getOrCreateInstance(modal).show();
    },

    async api(path, opts = {}) {
      const url = `/api/customer?path=${encodeURIComponent(path)}${opts.extra || ''}`;
      const r = await fetch(url, {
        method: opts.method || 'GET',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${this.token}` },
        ...(opts.body !== undefined ? { body: JSON.stringify(opts.body) } : {}),
      });
      if (r.status === 401) { this.handleLogout(); throw new Error('Session expired. Please log in again.'); }
      return r.json();
    },

    async loadDashboard() {
      this.loading = true; this.error = '';
      try {
        const [dashboardData, invoicesData] = await Promise.all([
          this.api('dashboard').catch(() => null),
          this.api('invoices?page=1').catch(() => null),
        ]);

        const data = dashboardData || {};
        const customer = data.customer || data.shop_customer || data.data || {};
        const invoiceList = this.invoiceArray(invoicesData)
          || (Array.isArray(data.invoices) ? data.invoices : null)
          || (data.invoices && Array.isArray(data.invoices.data) ? data.invoices.data : null)
          || (customer && Array.isArray(customer.invoices) ? customer.invoices : null)
          || (customer && customer.invoices && Array.isArray(customer.invoices.data) ? customer.invoices.data : null)
          || [];

        const latestInvoice = data.latest_invoice
          || data.latestInvoice
          || data.latest_order
          || data.latestOrder
          || invoiceList[0]
          || null;

        const completed = customer && customer.total_completed != null
          ? customer.total_completed
          : customer && customer.completed_orders != null
            ? customer.completed_orders
            : invoiceList.filter((inv) => inv && inv.status === 'completed').length;

        const spent = customer && customer.total_spent_usd != null
          ? customer.total_spent_usd
          : customer && customer.total_spent != null
            ? customer.total_spent
            : invoiceList.reduce((sum, inv) => {
                const n = parseFloat(inv && (inv.price_usd != null ? inv.price_usd : inv.price));
                return sum + (Number.isFinite(n) ? n : 0);
              }, 0);

        const createdAt = customer && (customer.created_at || customer.customer_since || customer.createdAt)
          ? (customer.created_at || customer.customer_since || customer.createdAt)
          : latestInvoice && latestInvoice.created_at
            ? latestInvoice.created_at
            : null;

        const email = customer.email
          || customer.customer_email
          || customer.billing_email
          || customer.user_email
          || (latestInvoice && (latestInvoice.email || latestInvoice.customer_email || latestInvoice.billing_email))
          || (invoiceList[0] && (invoiceList[0].email || invoiceList[0].customer_email || invoiceList[0].billing_email))
          || this.loginEmail
          || '';

        const balance = customer.balance != null
          ? customer.balance
          : customer.customer_balance != null
            ? customer.customer_balance
            : customer.balance_usd != null
              ? customer.balance_usd
              : data.balance != null
                ? data.balance
                : data.customer_balance != null
                  ? data.customer_balance
                  : null;

        this.customer = {
          ...customer,
          email,
          balance,
          total_completed: completed,
          total_spent_usd: spent,
          created_at: createdAt,
        };
        this.latestOrder = latestInvoice;
        if (invoicesData) this.orders = invoicesData;
      } catch (e) { this.error = String(e); } finally { this.loading = false; }
    },

    async loadOrders(page = 1) {
      this.loading = true; this.error = ''; this.ordersPage = page;
      try { this.orders = await this.api(`invoices?page=${page}`); }
      catch (e) { this.error = String(e); } finally { this.loading = false; }
    },

    async refreshDiscord() {
      try {
        const r = await fetch('/api/discord-status', { cache: 'no-store' });
        const data = await r.json();
        this.discordLinked = !!data.linked;
        this.discordUser = data.discord || null;
      } catch {
        this.discordLinked = false;
        this.discordUser = null;
      }
    },

    discordLabel() {
      if (!this.discordUser) return '';
      return this.discordUser.global_name || this.discordUser.username || 'Discord account';
    },

    discordLinkUrl() {
      return '/api/discord-login?next=' + encodeURIComponent(window.location.pathname + window.location.search);
    },

    async unlinkDiscord() {
      try {
        await fetch('/api/discord-logout', { method: 'POST' });
      } catch {}
      this.discordLinked = false;
      this.discordUser = null;
    },

    async loadTickets(page = 1) {
      this.loading = true; this.error = '';
      try { this.tickets = await this.api(`tickets?page=${page}`); }
      catch (e) { this.error = String(e); } finally { this.loading = false; }
    },

    async openTicket(id) {
      this.loading = true; this.error = ''; this.activeTicket = null;
      this.tab = 'tickets';
      try {
        this.activeTicket = await this.api(`tickets/${id}`);
        this.$nextTick(() => this.scrollMsgs());
        this.startTicketPoll(id);
      } catch (e) { this.error = String(e); } finally { this.loading = false; }
    },

    startTicketPoll(id) {
      this.stopTicketPoll();
      this.ticketPollTimer = setInterval(async () => {
        if (!this.activeTicket || this.activeTicket.id !== id) return this.stopTicketPoll();
        try { this.activeTicket = await this.api(`tickets/${id}`); this.$nextTick(() => this.scrollMsgs()); } catch {}
      }, 10000);
    },

    stopTicketPoll() {
      if (this.ticketPollTimer) { clearInterval(this.ticketPollTimer); this.ticketPollTimer = null; }
    },

    scrollMsgs() {
      if (this.$refs.msgScroll) this.$refs.msgScroll.scrollTop = this.$refs.msgScroll.scrollHeight;
    },

    async sendTicketMessage() {
      if (!this.ticketReply.trim()) return;
      this.ticketSending = true; this.ticketError = '';
      try {
        const r = await this.api(`tickets/${this.activeTicket.id}/messages`, { method: 'POST', body: { content: this.ticketReply } });
        if (r && r.message && !r.id) throw new Error(r.message);
        this.ticketReply = '';
        this.activeTicket = await this.api(`tickets/${this.activeTicket.id}`);
        this.$nextTick(() => this.scrollMsgs());
      } catch (e) { this.ticketError = String(e); } finally { this.ticketSending = false; }
    },

    openNewTicketFor(invoiceId) {
      const link = document.getElementById('cl-ticket-link');
      if (link) link.href = `{{ shop.url | safe }}/customer/tickets`;
      const m = document.getElementById('cl-ticket-modal');
      if (m && typeof bootstrap !== 'undefined') bootstrap.Modal.getOrCreateInstance(m).show();
    },

    async logout() {
      try { await this.api('logout', { method: 'POST' }); } catch {}
      this.handleLogout();
    },

    handleLogout() {
      if (typeof Cookies !== 'undefined') Cookies.remove('shop_customer_token', { path: '/' });
      window.dispatchEvent(new CustomEvent('cl:logout'));
      this.token = null; this.loggedIn = false; this.customer = null; this.loginEmail = '';
      this.orders = null; this.tickets = null; this.activeTicket = null;
      this.stopTicketPoll(); this.tab = 'dashboard';
    },

    async deleteAccount() {
      this.deletingAccount = true;
      try {
        await this.api('account', { method: 'DELETE' });
        const m = document.getElementById('cl-delete-modal');
        if (m && typeof bootstrap !== 'undefined') bootstrap.Modal.getOrCreateInstance(m).hide();
        this.handleLogout();
      } catch (e) { alert('Failed to delete account: ' + String(e)); }
      finally { this.deletingAccount = false; }
    },

    displayEmail() {
      return (this.customer && (
        this.customer.email
        || this.customer.customer_email
        || this.customer.billing_email
        || this.customer.user_email
      )) || this.loginEmail || '';
    },

    invoiceArray(payload) {
      if (!payload) return null;
      if (Array.isArray(payload)) return payload;
      if (Array.isArray(payload.data)) return payload.data;
      if (Array.isArray(payload.invoices)) return payload.invoices;
      if (payload.invoices && Array.isArray(payload.invoices.data)) return payload.invoices.data;
      return null;
    },

    customerBalance() {
      if (!this.customer) return null;
      const raw = this.customer.balance != null
        ? this.customer.balance
        : this.customer.customer_balance != null
          ? this.customer.customer_balance
          : this.customer.balance_usd != null
            ? this.customer.balance_usd
            : null;
      const n = parseFloat(raw);
      return Number.isFinite(n) ? n : null;
    },

    showBalanceCard() {
      return this.customerBalance() !== null;
    },

    invoiceUrl(inv) {
      return (inv && (inv.url || inv.invoice_url || inv.hosted_url || inv.portal_url)) || null;
    },

    invoiceKeys(inv) {
      const out = [];
      const push = (v) => {
        if (!v) return;
        const s = String(v).trim();
        if (!s) return;
        if (!out.includes(s)) out.push(s);
      };

      if (!inv || typeof inv !== 'object') return out;

      const direct = [
        inv.deliverable,
        inv.deliverables,
        inv.license,
        inv.licenses,
        inv.serial,
        inv.serials,
        inv.key,
        inv.keys,
        inv.code,
        inv.codes,
      ];

      for (const value of direct) {
        if (Array.isArray(value)) value.forEach(push);
        else if (value && typeof value === 'object') Object.values(value).forEach((x) => Array.isArray(x) ? x.forEach(push) : push(x));
        else push(value);
      }

      if (Array.isArray(inv.items)) {
        inv.items.forEach((item) => {
          if (!item || typeof item !== 'object') return;
          [item.deliverable, item.license, item.serial, item.key, item.code].forEach(push);
          [item.deliverables, item.licenses, item.serials, item.keys, item.codes].forEach((value) => {
            if (Array.isArray(value)) value.forEach(push);
            else if (value && typeof value === 'object') Object.values(value).forEach((x) => Array.isArray(x) ? x.forEach(push) : push(x));
            else push(value);
          });
        });
      }

      return out;
    },

    fmt(amount, currency) {
      const n = parseFloat(amount);
      if (!Number.isFinite(n)) return '$0.00';
      try { return new Intl.NumberFormat('en-US', { style: 'currency', currency: currency || 'USD' }).format(n); }
      catch { return '$' + n.toFixed(2); }
    },
    fmtPrice(amount, currency) { return this.fmt(amount, currency); },
    fmtDate(v) {
      if (!v) return '—';
      const d = new Date(v);
      if (isNaN(d.getTime())) return String(v);
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    },
    timeAgo(v) {
      if (!v) return '';
      const s = (new Date(v).getTime() - Date.now()) / 1000;
      const ranges = { year: 31536000, month: 2592000, week: 604800, day: 86400, hour: 3600, minute: 60, second: 1 };
      const fmt2 = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
      for (const [k, n] of Object.entries(ranges)) {
        if (Math.abs(s) >= n) return fmt2.format(Math.round(s / n), k);
      }
      return 'just now';
    },
  }));
});
</script>

