<section class="container component py-5-nav" style="min-height:60vh;display:flex;align-items:center;justify-content:center">
  <div class="row justify-content-center w-100">
    <div class="col-12 col-lg-6">
      <div class="cl-dash-card p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;border-radius:16px;background:rgba(59,130,246,.14);color:#60a5fa">
            <i class="fa fa-envelope" style="font-size:1.6rem"></i>
          </div>
          <h1 class="fw-bold mb-2">Login</h1>
          <p style="color:#9ab0cf" class="mb-0">
            Enter your email to get a one-time login code.
          </p>
        </div>

        <form x-data="clEmailLogin()" @submit.prevent="requestOtp()">
          <div x-show="step === 1">
            <div class="mb-1">
              <label class="mb-0 form-label">E-mail Address</label>
              <small class="d-block form-text">We'll send you a one-time password to this email address.</small>
            </div>
            <div class="mt-2">
              <input
                type="email"
                x-model="email"
                x-ref="emailInput"
                placeholder="name@domain.com"
                class="form-control"
                autocomplete="email"
              />
            </div>

            <div
              id="cl-captcha"
              class="cl-captcha mt-3"
              role="button"
              tabindex="0"
              aria-checked="false"
              x-on:cl-verified.window="altchaPayload = $event.detail; $el.classList.remove('loading'); $el.classList.add('done')"
              x-on:cl-reset.window="altchaPayload = null; $el.classList.remove('loading','done')"
            >
              <span class="cl-captcha-box">
                <svg class="cl-captcha-check" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M9 16.2l-3.5-3.5L4 14.2l5 5L20 8.2 18.5 6.7z"/></svg>
              </span>
              <span class="cl-captcha-label"></span>
              <span class="cl-captcha-spinner"></span>
            </div>

            <p x-show="error" class="form-text text-danger mt-2 mb-0" x-text="error"></p>

            <button
              type="submit"
              class="btn cl-dash-btn mt-4 w-100"
              :disabled="loading || !altchaPayload"
            >
              <span x-show="!loading">Continue</span>
              <span x-show="loading">Sending...</span>
            </button>
          </div>

          <div x-show="step === 2">
            <div class="mb-1">
              <label class="mb-0 form-label">One Time Password</label>
              <small class="d-block form-text">A 6-digit code has been sent to <span x-text="email"></span>.</small>
            </div>
            <div class="d-flex gap-2 mt-3 justify-content-center">
              <template x-for="(_, index) in otpDigits" :key="index">
                <input
                  type="text"
                  maxlength="1"
                  x-model="otpDigits[index]"
                  :data-index="index"
                  @input="handleOtpInput(index, $event)"
                  @keydown="handleOtpKeyDown(index, $event)"
                  class="form-control text-center cl-otp-input"
                />
              </template>
            </div>

            <p x-show="error" class="form-text text-danger mt-2 mb-0" x-text="error"></p>

            <button
              type="button"
              class="btn cl-dash-btn mt-4 w-100"
              :disabled="loading"
              @click="login()"
            >
              <span x-show="!loading">Log In</span>
              <span x-show="loading">Logging in...</span>
            </button>

            <button
              type="button"
              class="btn cl-dash-btn-outline mt-3 w-100"
              :disabled="loading"
              @click="back()"
            >
              Use another email
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
function clEmailLogin() {
  return {
    email: '',
    altchaPayload: null,
    loading: false,
    error: '',
    step: 1,
    otpDigits: ['', '', '', '', '', ''],

    async requestOtp() {
      this.error = '';
      if (!this.email) {
        this.error = 'Please enter your email address.';
        return;
      }
      if (!this.altchaPayload) {
        this.error = 'Please complete the captcha.';
        return;
      }

      this.loading = true;
      try {
        const res = await fetch(window.apiBaseUrl + 'v1/customer-dashboard/request-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: this.email,
            shop_id: window.shopId,
            altcha: this.altchaPayload,
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          this.error = data.message || 'Could not send login code.';
          this.altchaPayload = null;
          window.dispatchEvent(new CustomEvent('cl-reset', { detail: null }));
          return;
        }

        this.step = 2;
        this.$nextTick(() => {
          const first = document.querySelector('.cl-otp-input');
          if (first) first.focus();
        });
      } catch (_) {
        this.error = 'Network error. Please try again.';
        this.altchaPayload = null;
        window.dispatchEvent(new CustomEvent('cl-reset', { detail: null }));
      } finally {
        this.loading = false;
      }
    },

    async login() {
      this.error = '';
      const otp = this.otpDigits.join('');
      if (otp.length !== 6) {
        this.error = 'Enter the 6-digit code.';
        return;
      }

      this.loading = true;
      try {
        const res = await fetch(window.apiBaseUrl + 'v1/customer-dashboard/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            email: this.email,
            otp,
            shop_id: window.shopId,
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          this.error = data.message || 'Invalid code.';
          return;
        }

        window.location.href = 'https://clownium.mysellauth.com/customer/dashboard';
      } catch (_) {
        this.error = 'Network error. Please try again.';
      } finally {
        this.loading = false;
      }
    },

    back() {
      this.step = 1;
      this.error = '';
      this.otpDigits = ['', '', '', '', '', ''];
      this.altchaPayload = null;
      window.dispatchEvent(new CustomEvent('cl-reset', { detail: null }));
      this.$nextTick(() => {
        if (this.$refs.emailInput) this.$refs.emailInput.focus();
      });
    },

    handleOtpInput(index, event) {
      const value = (event.target.value || '').replace(/[^0-9]/g, '').slice(0, 1);
      this.otpDigits[index] = value;
      event.target.value = value;
      if (value && index < 5) {
        const next = document.querySelector('.cl-otp-input[data-index="' + (index + 1) + '"]');
        if (next) next.focus();
      }
    },

    handleOtpKeyDown(index, event) {
      if (event.key === 'Backspace' && !this.otpDigits[index] && index > 0) {
        const prev = document.querySelector('.cl-otp-input[data-index="' + (index - 1) + '"]');
        if (prev) prev.focus();
      }
    },
  };
}

(function () {
  async function solve(ch) {
    var enc = new TextEncoder();
    for (var n = 0; n <= (ch.maxnumber || 100000); n++) {
      var buf = await crypto.subtle.digest('SHA-256', enc.encode(ch.salt + n));
      var hex = '';
      new Uint8Array(buf).forEach(function (b) { hex += b.toString(16).padStart(2, '0'); });
      if (hex === ch.challenge) return n;
    }
    return -1;
  }

  var box = document.getElementById('cl-captcha');
  var busy = false;

  async function verify() {
    if (!box || busy || box.classList.contains('done')) return;
    busy = true;
    box.classList.add('loading');
    window.dispatchEvent(new CustomEvent('cl-reset', { detail: null }));
    try {
      var res = await fetch('/api/altcha', { cache: 'no-store' });
      if (!res.ok) throw new Error('challenge fetch failed ' + res.status);
      var data = await res.json();
      if (!data.challenge) throw new Error('no challenge in response');
      var number = await solve(data.challenge);
      if (number < 0) throw new Error('no solution found');
      var payload = btoa(JSON.stringify({
        algorithm: data.challenge.algorithm,
        challenge: data.challenge.challenge,
        number: number,
        salt: data.challenge.salt,
        signature: data.challenge.signature
      }));
      window.dispatchEvent(new CustomEvent('cl-verified', { detail: payload }));
    } catch (e) {
      box.classList.remove('loading');
      console.warn('captcha verify failed:', e);
    }
    busy = false;
  }

  if (box) {
    box.addEventListener('click', function () {
      if (!box.classList.contains('done')) verify();
    });
    box.addEventListener('keydown', function (e) {
      if ((e.key === 'Enter' || e.key === ' ') && !box.classList.contains('done')) {
        e.preventDefault();
        verify();
      }
    });
  }
})();
</script>

<style>
.cl-dash-card{
  background:linear-gradient(180deg,#0b1526 0%,#08101e 100%);
  border:1px solid rgba(120,180,255,.16);
  border-radius:18px;
  color:#e6efff;
  box-shadow:0 24px 60px rgba(0,10,30,.6), 0 0 0 1px rgba(0,0,0,.4);
}
.form-label{ color:#e6efff; font-weight:700; }
.form-text{ color:#9ab0cf; }
.form-control{
  background:#070a10;
  border:1px solid rgba(160,200,255,.14);
  color:#eaf2ff;
  font-weight:600;
  border-radius:10px;
  padding:.65rem .85rem;
}
.form-control:focus{
  background:#0a0f18;
  border-color:rgba(120,180,255,.5);
  box-shadow:0 0 0 3px rgba(33,150,243,.2);
  color:#fff;
}
.form-control::placeholder{ color:#6f8bb8 }
.cl-dash-btn{
  display:inline-flex; align-items:center; justify-content:center;
  padding:.8rem 1.4rem; border-radius:12px; border:0;
  font-weight:800; color:#041224; text-decoration:none;
  background:linear-gradient(90deg,#1d4ed8,#3b82f6);
  box-shadow:0 10px 26px rgba(0,90,255,.35);
  transition:transform .16s ease, box-shadow .2s ease;
}
.cl-dash-btn:hover{ transform:translateY(-1px); box-shadow:0 14px 30px rgba(0,90,255,.5) }
.cl-dash-btn:disabled{ opacity:.65 }
.cl-dash-btn-outline{
  display:inline-flex;align-items:center;justify-content:center;padding:.55rem 1.1rem;border-radius:10px;
  font-weight:700;color:#3b82f6;background:transparent;border:1px solid rgba(59,130,246,.4);
  transition:border-color .15s,background .15s;
}
.cl-dash-btn-outline:hover{border-color:#3b82f6;background:rgba(59,130,246,.1);color:#3b82f6}
.cl-otp-input{ width:2.75rem; height:3.1rem; font-size:1.25rem; text-align:center; }
.cl-captcha{
  display:flex; align-items:center; gap:.6rem;
  max-width:280px; margin:0;
  padding:.6rem .75rem;
  background:#0a0f18; border:1px solid rgba(160,200,255,.2); border-radius:10px;
  cursor:pointer; user-select:none;
  color:#e6efff; font-size:.88rem; font-weight:600;
  transition:border-color .2s ease, background .2s ease;
}
.cl-captcha:hover{ border-color:rgba(120,180,255,.45) }
.cl-captcha-box{
  width:22px; height:22px; flex:0 0 auto;
  border:2px solid #6f8bb8; border-radius:5px;
  display:inline-flex; align-items:center; justify-content:center;
  color:transparent;
  transition:all .2s ease;
}
.cl-captcha-check{ display:block }
.cl-captcha.done .cl-captcha-box{ border-color:#22c55e; background:#22c55e; color:#041224 }
.cl-captcha-label::before{ content:"I'm not a robot" }
.cl-captcha.loading .cl-captcha-label::before{ content:"Verifying..." }
.cl-captcha.done .cl-captcha-label::before{ content:"Verified" }
.cl-captcha-spinner{
  display:none; width:18px; height:18px; flex:0 0 auto;
  border:2px solid rgba(120,180,255,.3); border-top-color:#3b82f6; border-radius:50%;
  animation:cl-captcha-spin .8s linear infinite;
}
.cl-captcha.loading .cl-captcha-spinner{ display:inline-block }
.cl-captcha.loading .cl-captcha-box{ display:none }
@keyframes cl-captcha-spin{ to{ transform:rotate(360deg) } }
</style>
