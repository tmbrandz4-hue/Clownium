{# =========================
   components/hero.njk — Clownium hero (dark + blue glow), clean fragment
   ========================= #}
{% set _title = properties.title | renderString %}
{% set _subtitle = properties.subtitle | renderString %}
{% if not _title %}{% set _title = 'Play with an Advantage.' %}{% endif %}
{% if not _subtitle %}{% set _subtitle = 'Premium cheat services delivered instantly, with 24/7 support.' %}{% endif %}

<section class="hb-hero component" data-component-id="{{ componentId }}">
  <div class="container position-relative">
    <div class="row align-items-center justify-content-center">
      <div class="col-12 col-lg-9 text-center">
        <h1>{{ _title }}</h1>
        <p class="subtitle">{{ _subtitle }}</p>
        <div class="cta-row">
          <a href="{{ '/#shop' | shopUrl }}" class="btn btn-cta">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 22a2 2 0 1 1 0-4 2 2 0 0 1 0 4m10 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4M3 2h2.15a2 2 0 0 1 1.93 1.48L7.6 6H20a1 1 0 0 1 .97 1.24l-1.82 7.28A3 3 0 0 1 16.22 17H9.78a3 3 0 0 1-2.9-2.48L5.05 4H3z"/></svg>
            View Products
          </a>
          <a href="{{ shop.discord_url or 'https://discord.gg/2dDR3fg4Ry' }}" target="_blank" rel="noopener" class="btn btn-ghost">
            <i class="fa-brands fa-discord"></i>
            Join Discord
          </a>
        </div>

        <div class="stats-row">
          {% if properties.show_products_sold %}
          <div class="stat">
            <span class="num" x-text="appCurrency.formatNumber ? appCurrency.formatNumber({{ shop.products_sold }}) : '{{ shop.products_sold }}'">0</span>
            <span class="lbl">Products Sold</span>
          </div>
          {% endif %}
          {% if properties.show_total_customers %}
          <div class="stat">
            <span class="num" x-text="appCurrency.formatNumber ? appCurrency.formatNumber({{ shop.total_customers }}) : '{{ shop.total_customers }}'">0</span>
            <span class="lbl">Total Customers</span>
          </div>
          {% endif %}
          {% if properties.show_feedback_rating %}
          <div class="stat">
            <span class="num">{{ shop.average_rating }}<i class="fa-solid fa-star"></i></span>
            <span class="lbl">Average Rating</span>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.hb-hero{
  --accent:#3b82f6; --accent-dark:#1d4ed8;
  position:relative; overflow:hidden;
  padding: 6rem 0 5rem;
  text-align:center; color:#fff;
}
.hb-hero .container{ z-index:1 }
.hb-hero .eyebrow{
  display:inline-flex; align-items:center; gap:.5rem;
  color:#8fb8ff; font-weight:700; letter-spacing:.28em; text-transform:uppercase; font-size:.8rem;
  padding:.4rem 1rem; border:1px solid rgba(120,180,255,.22); border-radius:999px;
  background:rgba(0,40,120,.25); box-shadow:0 0 18px rgba(0,80,255,.25);
}
.hb-hero h1{
  margin:1.4rem 0 .8rem; font-weight:900; font-size:clamp(2.4rem,6vw,4rem); line-height:1.06;
  background:linear-gradient(180deg,#ffffff 20%, #9cc2ff 100%);
  -webkit-background-clip:text; background-clip:text; color:transparent;
  text-shadow:0 0 40px rgba(0,120,255,.35);
}
.hb-hero .subtitle{
  color:#c7d6f2; font-size:clamp(1rem,2.4vw,1.25rem); max-width:640px; margin:0 auto 2rem;
}
.hb-hero .cta-row{ display:flex; gap:1rem; justify-content:center; flex-wrap:wrap }
.hb-hero .btn-cta{
  display:inline-flex; align-items:center; gap:.6rem; padding:.85rem 1.6rem;
  border-radius:14px; font-weight:800; color:#041224; text-decoration:none;
  background:linear-gradient(90deg, var(--accent-dark), var(--accent));
  box-shadow:0 14px 34px rgba(0,90,255,.45), inset 0 1px 0 rgba(255,255,255,.35);
  transition:transform .16s ease, box-shadow .2s ease;
}
.hb-hero .btn-cta:hover{ transform:translateY(-2px); box-shadow:0 20px 44px rgba(0,90,255,.6) }
.hb-hero .btn-ghost{
  display:inline-flex; align-items:center; gap:.6rem; padding:.85rem 1.6rem;
  border-radius:14px; font-weight:800; color:#eaf2ff; text-decoration:none;
  border:1px solid rgba(120,180,255,.35); background:rgba(255,255,255,.04);
  transition:transform .16s ease, background .2s ease;
}
.hb-hero .btn-ghost:hover{ transform:translateY(-2px); background:rgba(255,255,255,.08) }
.hb-hero .stats-row{
  display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; margin-top:3rem;
}
.hb-hero .stat{
  min-width:150px; padding:1.1rem 1.4rem; border-radius:16px;
  background:rgba(255,255,255,.035); border:1px solid rgba(120,180,255,.14);
  box-shadow:0 12px 30px rgba(0,10,30,.5);
}
.hb-hero .stat .num{
  display:block; font-size:1.7rem; font-weight:900; color:#fff;
  text-shadow:0 0 14px rgba(77,162,255,.5);
}
.hb-hero .stat .num i{ color:#FFD700; font-size:1rem; margin-left:.35rem }
.hb-hero .stat .lbl{ display:block; color:#8fa6c8; font-size:.85rem; font-weight:600; margin-top:.2rem }
@media (max-width:576px){
  .hb-hero .stat{ min-width:120px }
}
</style>