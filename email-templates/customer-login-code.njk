{% block subject %}
  {{ shop.name }} - {{ otp }} is your Login Code
{% endblock %}

{% block content %}
  <h1 style="font-family: 'Nebular Oblique', 'SF Pro Display', Arial, sans-serif; color: #041224; font-size: 24px; font-weight: 700; margin: 0 0 8px 0;">
    Your login code
  </h1>
  <p style="font-family: Arial, sans-serif; color: #3f4a5c; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0;">
    Use the code below to sign in to <strong style="color: #0a1628;">{{ shop.name }}</strong>. Do not share it with anyone.
  </p>

  <div class="code-block" style="background-color: #041224; border: 1px solid #1d4ed8; border-radius: 12px; color: #6ea8ff; font-family: 'Geist Mono', 'SF Mono', 'Fira Code', ui-monospace, 'Courier New', monospace; font-size: 32px; font-weight: 700; letter-spacing: 0.18em; margin: 0 0 20px 0; padding: 20px 24px; text-align: center;">
    {{ otp }}
  </div>

  <p style="text-align: center; color: #8a97b0; font-size: 13px; margin: 0 0 20px 0;">
    This code expires in <strong style="color: #e6efff;">{{ otp_expiry if otp_expiry else '15 minutes' }}</strong>.
  </p>

  <div style="background-color: rgba(13, 34, 70, 0.08); border-radius: 8px; padding: 12px 16px; margin: 0;">
    <p style="color: #8a97b0; font-size: 13px; margin: 0; text-align: center;">
      If you didn&apos;t request this code, you can safely ignore this email. Your account remains secure.
    </p>
  </div>
{% endblock %}