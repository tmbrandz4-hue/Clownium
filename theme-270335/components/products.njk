        events: { onhover: { enable: true, mode: "repulse" }, onclick: { enable: true, mode: "push" }, resize: true },
        modes: { repulse: { distance: 110, duration: 0.3 }, push: { particles_nb: 4 } }
      },
      retina_detect: true
    });
  }
  function waitForLib(tries) {
    if (window.particlesJS) { startParticles(); return; }
    if (tries <= 0) { console.warn("particles.js not found"); return; }
    setTimeout(function () { waitForLib(tries - 1); }, 100);
  }
  window.addEventListener("load", function () { waitForLib(100); });
})();
</script>

