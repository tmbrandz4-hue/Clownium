<style>
/* ===== Categories Bar ===== */
.category-nav {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 2rem;
  gap: 0.5rem;
  position: relative;
  z-index: 100;
}
.category-btn {
  padding: 0.75rem 1.5rem;
  border-radius: 9999px;
  font-weight: 500;
  transition: all 0.3s ease;
  background-color: #02031a;
  color: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.1);
  cursor: pointer;
  position: relative;
  z-index: 101;
  pointer-events: auto;
  white-space: nowrap;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}
@media (max-width: 768px) {
  .category-btn { padding: 0.6rem 1.2rem; font-size: 0.8rem; }
  .category-nav { justify-content: center; gap: 0.3rem; }
}
.category-btn:hover {
  background-color: #080a36;
  color: rgba(255, 255, 255, 0.9);
  transform: translateY(-1px);
  box-shadow: 0 6px 12px rgba(0,0,0,0.15);
}
.category-btn.active {
  background-color: #6571ff;
  color: rgba(255,255,255,1);
  border-color: rgba(255,255,255,0.2);
  box-shadow: 0 4px 12px rgba(101,113,255,0.4);
}

/* Utility */
.badge-dark-blue {
  background: linear-gradient(90deg, #0b1a49, #1a3dd6);
  box-shadow: 0 8px 20px rgba(26, 61, 214, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  font-weight: 700;
  letter-spacing: 0.02em;
  border-radius: 999px;
}

</style>



<!-- ===== Products Section ===== -->
<section class="container py-20 component" id="{{ componentId }}" data-component-id="{{ componentId }}">
  {% if properties.title %}
  <div class="section-title">
    <h2>{{ properties.title | renderString }}</h2>
  </div>
  {% endif %}
  {% if properties.subtitle %}
  <div class="section-subtitle">
    <p>{{ properties.subtitle | renderString }}</p>
  </div>
  {% endif %}

  <div>
    <div class="row products">
      {% if properties.ids|length == 0 %}
        {% for product in sortedItems %}
          {% if product.type == 'group' or not product.group_id %}
            {% render_snippet "product-card.njk", product=product %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% for product in helpers.components.products.getItemsByIds(sortedItems, properties.ids) %}
          {% render_snippet "product-card.njk", product=product %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<!-- ===== Group Modals ===== -->
{% for product in sortedItems %}
  {% if product.type == 'group' %}
    <div class="modal fade" id="group-modal-{{ product.id }}" tabindex="-1" aria-labelledby="group-modal-{{ product.id }}-label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="background:#0d0f17;color:#fff;border:1px solid rgba(255,255,255,.08);">
          <div class="modal-header" style="border-color:rgba(255,255,255,.08)">
            <h5 class="modal-title" id="group-modal-{{ product.id }}-label">{{ product.name }} Products</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter:invert(1)"></button>
          </div>
          <div class="modal-body">
            <div class="products row">
              {% for product in product.products %}
                {% render_snippet "product-card.njk", product=product %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
{% endfor %}

