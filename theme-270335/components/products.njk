<!-- ===== Category Filter Logic (SCOPED TO MAIN GRID ONLY) ===== -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  const buttons = document.querySelectorAll(".category-btn");

  // Only main .row.products (NOT inside modals)
  const mainProductsContainer = Array.from(document.querySelectorAll(".row.products"))
    .find(list => !list.closest(".modal"));

  if (!mainProductsContainer) return;

  const productCards = Array.from(mainProductsContainer.children);

  const TITLE_SELECTORS = [
    "[data-product-name]",
    ".product-title",
    ".card-title",
    "h3",
    "h4",
    "[itemprop='name']",
    "[aria-label]"
  ];

  function extractName(card) {
    if (card.dataset.name) return card.dataset.name;
    let name = "";
    for (const sel of TITLE_SELECTORS) {
      const el = card.querySelector(sel);
      if (el) {
        name = (el.getAttribute("data-product-name") ||
                el.getAttribute("aria-label") ||
                el.textContent ||
                "").trim();
        if (name) break;
      }
    }
    if (!name) name = (card.textContent || "").trim();
    const cleaned = name.toLowerCase();
    card.dataset.name = cleaned;
    return cleaned;
  }

  function matchesDataCategory(card, category) {
    const dc = (card.dataset.category || "").toLowerCase();
    return dc && dc === category;
  }

  function matchesName(card, category) {
    const keywords = CATEGORY_KEYWORDS[category] || [];
    const name = extractName(card);
    return keywords.some(kw => name.includes(kw));
  }

  function productMatches(card, category) {
    if (category === "all") return true;
    return matchesDataCategory(card, category) || matchesName(card, category);
  }

  function applyFilter(category) {
    productCards.forEach(card => {
      if (!(card instanceof HTMLElement)) return;
      card.style.display = productMatches(card, category) ? "" : "none";
    });
  }

  // initial view
  applyFilter("all");

  // buttons
  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      const cat = (btn.getAttribute("data-category") || "all").toLowerCase();
      applyFilter(cat);
    });
  });

  // Ensure modal contents never inherit hidden state
  document.addEventListener("shown.bs.modal", (e) => {
    if (e.target && e.target.matches(".modal")) {
      const modalProducts = e.target.querySelectorAll(".row.products > *");
      modalProducts.forEach(el => { el.style.display = ""; });
    }
  });
});
</script>

