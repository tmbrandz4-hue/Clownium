{% set _topupAmounts = topup_amounts %}

<section id="{{ componentId }}" class="component sa-page-customer-balance py-section" data-component-id="{{ componentId }}">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-8 items-start">
      {% render_snippet "customer-sidebar.njk" %}

      <div class="min-w-0">
        {% render_snippet "customer-header.njk",
          ch_title=properties.title,
          ch_subtitle=properties.subtitle
        %}

        <div class="grid gap-grid-gap md:grid-cols-2 items-stretch">
          <div class="rounded-card border border-accent-500/50 ring-1 ring-accent-500/15 bg-surface shadow-card p-5">
            <span class="size-9 rounded-input bg-accent-500/10 text-accent-500 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
            </span>
            <p class="sa-page-customer-balance-price text-3xl font-semibold text-t-primary mt-4 truncate">
              <span x-text="appCurrency.format({{ shop_customer.balance }}, 'USD')">{{ formatPrice(shop_customer.balance, 'USD') }}</span>
            </p>
            <p class="text-sm text-t-muted mt-1">Available balance, used automatically at checkout{{ ' and for reseller orders' if shop.settings.reseller.enabled }}.</p>
          </div>

          <div class="rounded-card border border-theme bg-surface shadow-card p-5">
            <h2 class="text-sm font-medium text-t-primary">{{ 'balance.top_up' | t }}</h2>
            {% if balance_product_id and balance_product_variant_id %}
              <form x-data="topUpBalance" @submit.prevent="buy">
                <p class="text-sm text-t-muted mt-1 mb-4">{{ 'balance.pick_amount' | t }}</p>
                {% if altcha %}
                  <div
                    x-cloak
                    x-show="!altchaPayload"
                    class="mb-3 transition-opacity"
                    x-transition:enter="transition ease-out duration-300 transform"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-200 transform"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                  >
                    <altcha-widget
                      challengejson='{{ altcha | json }}'
                      auto="onload"
                      hidefooter="true"
                      hidelogo="true"
                      x-ref="altcha"
                    ></altcha-widget>
                  </div>
                {% endif %}
                <div class="sa-page-customer-balance-actions grid grid-cols-3 gap-2">
                  {% for item in _topupAmounts %}
                    <button
                      type="button"
                      @click="amount = amount === {{ item.amount }} ? null : {{ item.amount }}"
                      :class="amount === {{ item.amount }} ? 'border-accent-500 bg-accent-500/10 text-accent-500' : 'border-theme text-t-primary hover:border-accent-500/50 hover:text-accent-500'"
                      :aria-pressed="amount === {{ item.amount }}"
                      class="px-2 py-2.5 text-sm font-medium text-center rounded-btn border transition-colors duration-theme"
                    >{{ formatPrice(item.credit, 'USD') }}{% if item.credit != item.amount %}<span class="block mt-0.5 text-[0.65rem] font-normal opacity-70">{{ 'balance.pay_amount' | t({ amount: formatPrice(item.amount, 'USD') }) }}</span>{% endif %}</button>
                  {% endfor %}
                </div>
                {% if topup_allow_custom %}
                  <div class="sa-page-customer-balance-custom relative mt-2">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-t-muted pointer-events-none">$</span>
                    <input
                      type="number"
                      inputmode="decimal"
                      min="{{ topup_min }}"
                      max="{{ topup_max }}"
                      step="1"
                      x-model.number="amount"
                      placeholder="{{ 'balance.custom_amount_placeholder' | t }}"
                      class="w-full rounded-btn border border-theme bg-surface pl-7 pr-3 py-2.5 text-sm text-t-primary focus:border-accent-500/50 focus:outline-none"
                    />
                  </div>
                {% endif %}
                <button
                  type="submit"
                  :disabled="!topUpValid || buyingAmount !== null || buyNowDisabled"
                  class="sa-page-customer-balance-submit w-full mt-3 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium rounded-btn bg-accent-500 text-on-accent hover:enabled:bg-accent-600 transition-colors duration-theme shadow-btn disabled:opacity-50 disabled:pointer-events-none"
                >
                  <svg x-cloak x-show="buyingAmount !== null" xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                  <span x-text="topUpValid ? 'Add ' + appCurrency.format(creditAmount, 'USD') : 'Add funds'">{{ 'balance.add_funds' | t }}</span>
                </button>
                {% if topup_allow_custom %}
                  <p class="text-xs text-t-muted mt-2">Minimum {{ formatPrice(topup_min, 'USD') }}, maximum {{ formatPrice(topup_max, 'USD') }}.</p>
                {% endif %}
              </form>
            {% else %}
              <p class="text-sm text-t-muted mt-1">{{ 'balance.topup_unavailable' | t }}</p>
            {% endif %}
          </div>
        </div>

        <div class="sa-page-customer-balance-items rounded-card border border-theme bg-surface shadow-card mt-4">
          <div class="px-4 sm:px-5 py-3.5 border-b border-theme">
            <h2 class="text-sm font-medium text-t-primary">{{ 'balance.transaction_history' | t }}</h2>
          </div>
          {% if balance_transactions.length > 0 %}
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm text-t-primary">
                <thead>
                  <tr class="border-b border-theme">
                    <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">ID</th>
                    <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'common.type' | t }}</th>
                    <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'common.description' | t }}</th>
                    <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'common.amount' | t }}</th>
                    <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'common.date' | t }}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-theme">
                  {% for transaction in balance_transactions %}
                    <tr>
                      <td class="px-4 sm:px-5 py-3.5 whitespace-nowrap text-t-muted">{{ transaction.id }}</td>
                      <td class="px-4 sm:px-5 py-3.5 whitespace-nowrap capitalize">{{ transaction.type }}</td>
                      <td class="px-4 sm:px-5 py-3.5 whitespace-nowrap">
                        {% if transaction.description %}
                          {{ transaction.description }}
                        {% elif transaction.invoice %}
                          <a href="/checkout/{{ transaction.invoice.unique_id }}" target="_blank" class="text-accent-500 hover:text-accent-600 transition-colors duration-theme">
                            Invoice #{{ transaction.invoice.unique_id }}
                          </a>
                        {% else %}
                          —
                        {% endif %}
                      </td>
                      <td class="px-4 sm:px-5 py-3.5 whitespace-nowrap font-medium">{{ formatPrice(transaction.amount, 'USD') }}</td>
                      <td class="px-4 sm:px-5 py-3.5 whitespace-nowrap text-t-muted">{{ transaction.created_at | formatDateTime }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <p class="text-sm text-t-muted p-4 sm:p-5">{{ 'balance.no_transactions' | t }}</p>
          {% endif %}
          {% if balance_transactions_paginator.last_page > 1 %}
            <div class="px-4 sm:px-5 pb-4">
              {% render_snippet "pagination.njk", paginator=balance_transactions_paginator %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('topUpBalance', () => ({
      amount: null,
      buyingAmount: null,
      altchaPayload: null,
      buyNowDisabled: {{ 'true' if altcha else 'false' }},

      topUpPresets: {{ _topupAmounts | json }},

      get creditAmount() {
        const preset = this.topUpPresets.find((p) => p.amount === this.amount);
        return preset ? preset.credit : this.amount;
      },

      get topUpValid() {
        return Number.isFinite(this.amount) && this.amount >= {{ topup_min }} && this.amount <= {{ topup_max }};
      },

      init: function () {
        {% if altcha %}
          this.addAltchaEventListener();
        {% endif %}
      },

      addAltchaEventListener: function () {
        this.$refs.altcha.addEventListener('statechange', (event) => {
          if (event.detail.state === 'verifying') {
            this.buyNowDisabled = true;
          } else if (event.detail.state === 'verified') {
            this.buyNowDisabled = false;
            this.altchaPayload = event.detail.payload;
          }
        });
      },

      generateRecaptchaToken: async function () {
        return new Promise((resolve) => {
          grecaptcha.ready(
            () =>
              void (async () => {
                const token = await grecaptcha.execute(
                  '{{ shop.recaptcha_key }}',
                  { action: 'buynow_s{{ shop.id }}' },
                );

                resolve(token);
              })(),
          );
        });
      },

      buy: async function () {
        if (!this.topUpValid || this.buyingAmount !== null) {
          return;
        }

        const formData = {
          cart: [{
            productId: {{ balance_product_id }},
            variantId: {{ balance_product_variant_id }},
            quantity: this.amount,
          }],
          currency: this.appCurrency.currency,
          shopId: '{{ shop.id }}',
          source: 'storefront',
        };

        if (window.shopCustomer?.email) {
          formData.email = window.shopCustomer.email;
        }

        {% if altcha %}
          if (this.altchaPayload) {
            formData.altcha = this.altchaPayload;
          }
        {% elif shop.recaptcha_key %}
          try {
            formData.recaptchaToken = await this.generateRecaptchaToken();
          } catch (error) {
            console.error(error);
          }
        {% endif %}

        try {
          this.buyingAmount = this.amount;

          const response = await fetch('{{ '/v1/checkout' | apiInternalUrl }}', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData),
          });

          const responseData = await response.json();

          if (responseData.url) {
            window.location.href = responseData.url;
          }
        } catch (error) {
          console.error(error);
        } finally {
          this.buyingAmount = null;
          this.amount = null;
        }
      }
    }));
  });
</script>
