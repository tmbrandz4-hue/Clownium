<style id="theme-styles">
  :root {
    /* Core brand + palette (night blues) */
    --cl-accent: #3b82f6;                  /* primary electric blue */
    --cl-accent-rgb: 59,130,246;

    --cl-background-primary: #0b0f14;      /* near-black with blue tint */
    --cl-background-primary-rgb: 11,15,20;

    --cl-background-secondary: #0d1320;    /* deeper night */
    --cl-background-secondary-rgb: 13,19,32;

    --cl-border: rgba(166, 195, 255, 0.08);
    --cl-border-rgb: 166,195,255,0.08;

    --bs-font-sans-serif: 'Poppins', sans-serif;
    --cl-snow: 234,242,255;                /* light ink for night */
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" id="theme-font">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/styles/choices.min.css" rel="stylesheet" integrity="sha256-gS3HxgWFFFqEo0wQoALebu5XlWdYr3gqd4/Tk5wt8Ig=" crossorigin="anonymous" />

<canvas id="globalCanvas" style="
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: -1;
  pointer-events: none;
"></canvas>

<script>
class ScrollableBackground {
  constructor() {
    this.canvas = document.getElementById('globalCanvas');
    this.ctx = this.canvas.getContext('2d');
    this.particles = [];
    this.gridOpacity = 0.12;
    this.gridPulse = 0;
    this.time = 0;
    this.scrollY = 0;

    this.resizeCanvas();
    window.addEventListener('resize', () => this.resizeCanvas());
    window.addEventListener('scroll', () => this.handleScroll());

    this.initParticles();
    this.animate();
  }

  resizeCanvas() {
    this.canvas.width = window.innerWidth;
    this.canvas.height = Math.max(document.documentElement.scrollHeight, window.innerHeight);
    this.canvas.style.height = this.canvas.height + 'px';
  }

  handleScroll() {
    this.scrollY = window.scrollY;
    this.draw();
  }

  initParticles() {
    const particleCount = Math.min(28, Math.floor(window.innerWidth / 70));

    for (let i = 0; i < particleCount; i++) {
      this.particles.push({
        x: Math.random() * this.canvas.width,
        y: Math.random() * this.canvas.height,
        size: Math.random() * 2 + 1,
        speedY: Math.random() * 1 + 0.5,
        speedX: (Math.random() - 0.5) * 0.5,
        opacity: Math.random() * 0.6 + 0.2,
        color: Math.random() < 0.7 ? 'rgba(77, 162, 255, ' : 'rgba(31, 106, 255, ',
        life: Math.random() * Math.PI * 2,
        lifeSpeed: Math.random() * 0.02 + 0.01
      });
    }
  }

  drawGrid() {
    const gridSize = 48;
    const width = this.canvas.width;
    const height = this.canvas.height;

    this.gridPulse = Math.sin(this.time * 0.001) * 0.05 + this.gridOpacity;

    this.ctx.strokeStyle = `rgba(77, 162, 255, ${this.gridPulse})`;
    this.ctx.lineWidth = 1;
    this.ctx.beginPath();

    for (let x = 0; x <= width; x += gridSize) {
      this.ctx.moveTo(x, 0);
      this.ctx.lineTo(x, height);
    }

    for (let y = 0; y <= height; y += gridSize) {
      this.ctx.moveTo(0, y);
      this.ctx.lineTo(width, y);
    }

    this.ctx.stroke();

    this.applyRadialMasks();
  }

  applyRadialMasks() {
    const width = this.canvas.width;
    const height = this.canvas.height;

    this.ctx.globalCompositeOperation = 'destination-out';

    const centerX = width / 2;
    const centerY = height / 3;
    const maxRadius = Math.min(width, height) * 0.8;

    const gradient1 = this.ctx.createRadialGradient(
      centerX, centerY, maxRadius * 0.3,
      centerX, centerY, maxRadius
    );
    gradient1.addColorStop(0, 'rgba(0, 0, 0, 0)');
    gradient1.addColorStop(1, 'rgba(0, 0, 0, 0.8)');

    this.ctx.fillStyle = gradient1;
    this.ctx.fillRect(0, 0, width, height);

    if (height > window.innerHeight) {
      const gradient2 = this.ctx.createRadialGradient(
        centerX, height * 0.7, maxRadius * 0.2,
        centerX, height * 0.7, maxRadius * 0.6
      );
      gradient2.addColorStop(0, 'rgba(0, 0, 0, 0)');
      gradient2.addColorStop(1, 'rgba(0, 0, 0, 0.6)');

      this.ctx.fillStyle = gradient2;
      this.ctx.fillRect(0, 0, width, height);
    }

    this.ctx.globalCompositeOperation = 'source-over';
  }

  drawBackgroundGradients() {
    const width = this.canvas.width;
    const height = this.canvas.height;

    const grad1 = this.ctx.createRadialGradient(
      width * 0.3, height * 0.15, 0,
      width * 0.3, height * 0.15, width * 0.6
    );
    grad1.addColorStop(0, 'rgba(77, 162, 255, 0.14)');
    grad1.addColorStop(1, 'rgba(77, 162, 255, 0)');

    this.ctx.fillStyle = grad1;
    this.ctx.fillRect(0, 0, width, height);

    const grad2 = this.ctx.createRadialGradient(
      width * 0.7, height * 0.5, 0,
      width * 0.7, height * 0.5, width * 0.5
    );
    grad2.addColorStop(0, 'rgba(31, 106, 255, 0.1)');
    grad2.addColorStop(1, 'rgba(31, 106, 255, 0)');

    this.ctx.fillStyle = grad2;
    this.ctx.fillRect(0, 0, width, height);

    if (height > window.innerHeight * 1.5) {
      const grad3 = this.ctx.createRadialGradient(
        width * 0.2, height * 0.8, 0,
        width * 0.2, height * 0.8, width * 0.4
      );
      grad3.addColorStop(0, 'rgba(77, 162, 255, 0.08)');
      grad3.addColorStop(1, 'rgba(77, 162, 255, 0)');

      this.ctx.fillStyle = grad3;
      this.ctx.fillRect(0, 0, width, height);
    }
  }

  updateParticles() {
    this.particles.forEach(particle => {
      particle.y -= particle.speedY;
      particle.x += particle.speedX + Math.sin(particle.life) * 0.5;
      particle.life += particle.lifeSpeed;

      if (particle.y < -10) {
        particle.y = this.canvas.height + 10;
        particle.x = Math.random() * this.canvas.width;
      }

      if (particle.x < -10) particle.x = this.canvas.width + 10;
      if (particle.x > this.canvas.width + 10) particle.x = -10;
    });
  }

  drawParticles() {
    this.particles.forEach(particle => {
      this.ctx.beginPath();
      this.ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
      this.ctx.fillStyle = particle.color + particle.opacity + ')';
      this.ctx.shadowBlur = 8;
      this.ctx.shadowColor = particle.color + '0.8)';
      this.ctx.fill();
      this.ctx.shadowBlur = 0;
    });
  }

  draw() {
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    this.drawBackgroundGradients();
    this.drawGrid();
    this.drawParticles();
  }

  animate() {
    this.time = performance.now();
    this.updateParticles();
    this.draw();
    requestAnimationFrame(() => this.animate());
  }
}

document.addEventListener('DOMContentLoaded', () => {
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    new ScrollableBackground();
  } else {
    const canvas = document.getElementById('globalCanvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = Math.max(document.documentElement.scrollHeight, window.innerHeight);
    canvas.style.height = canvas.height + 'px';

    const gridSize = 48;
    ctx.strokeStyle = 'rgba(77, 162, 255, 0.1)';
    ctx.lineWidth = 1;
    ctx.beginPath();

    for (let x = 0; x <= canvas.width; x += gridSize) {
      ctx.moveTo(x, 0);
      ctx.lineTo(x, canvas.height);
    }
    for (let y = 0; y <= canvas.height; y += gridSize) {
      ctx.moveTo(0, y);
      ctx.lineTo(canvas.width, y);
    }
    ctx.stroke();
  }
});

window.addEventListener('resize', () => {
  const canvas = document.getElementById('globalCanvas');
  if (canvas) {
    canvas.width = window.innerWidth;
    canvas.height = Math.max(document.documentElement.scrollHeight, window.innerHeight);
    canvas.style.height = canvas.height + 'px';
  }
});

const resizeObserver = new ResizeObserver(() => {
  const canvas = document.getElementById('globalCanvas');
  if (canvas) {
    const newHeight = Math.max(document.documentElement.scrollHeight, window.innerHeight);
    if (canvas.height !== newHeight) {
      canvas.height = newHeight;
      canvas.style.height = newHeight + 'px';
    }
  }
});

document.addEventListener('DOMContentLoaded', () => {
  resizeObserver.observe(document.body);
});
</script>

    
<div class="container component" data-component-id="{{ componentId }}">
  <section class="py-5-nav">
    <div class="section-title">
      <h1>Customer Reviews</h1>
    </div>
    <div class="testimonials row">
      {% for feedback in feedbacks %}
      <div class="col-12 col-md-6 col-lg-4 col-xl-3">
        {% render_snippet "feedback-card.njk", feedback=feedback %}
      </div>
      {% endfor %}
    </div>
    {% if feedbacksPaginator and feedbacksPaginator.last_page > 1 %}
      {% render_snippet "pagination.njk", paginator=feedbacksPaginator %}
    {% endif %}
  </section>
</div>