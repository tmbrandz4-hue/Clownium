<section class="menu-cheat-section component" data-component-id="{{ componentId }}">
  <div class="menu-container">
    <div class="menu-card">
      <svg class="menu-plus-icon menu-plus-top-left" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14"></path>
        <path d="M12 5v14"></path>
      </svg>
      <svg class="menu-plus-icon menu-plus-top-right" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14"></path>
        <path d="M12 5v14"></path>
      </svg>
      <svg class="menu-plus-icon menu-plus-bottom-left" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14"></path>
        <path d="M12 5v14"></path>
      </svg>
      <svg class="menu-plus-icon menu-plus-bottom-right" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14"></path>
        <path d="M12 5v14"></path>
      </svg>
      
      <div class="menu-content-wrapper pc-reveal-content">
        <div class="menu-info-section">
          {% if properties.badge_text %}
          <div class="info-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor">
              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"></path>
            </svg>
            <span>{{ properties.badge_text | renderString }}</span>
          </div>
          {% endif %}
          
          {% if properties.title %}
          <h2 class="info-title">{{ properties.title | renderString }}</h2>
          {% endif %}

          {% if properties.subtitle %}
          <p class="info-subtitle">{{ properties.subtitle | renderString }}</p>
          {% endif %}
          
          <div class="features-list">
            {% for feature in properties.features %}
            <div class="feature-item">
              {% if feature.icon %}
                <i class="{{ feature.icon }} feature-icon-style"></i>
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
                  <path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path>
                </svg>
              {% endif %}
              <div>
                <span class="feature-title">{{ feature.title | renderString }}</span>
                <span class="feature-desc">{{ feature.description | renderString }}</span>
              </div>
            </div>
            {% endfor %}
          </div>
          
          <div class="action-buttons">
            {% if properties.primary_button_text %}
            <a href="{{ properties.primary_button_link | shopUrl if properties.primary_button_link.startsWith('/') else properties.primary_button_link }}" class="action-btn action-btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
                <path d="M224,152v56a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V152a8,8,0,0,1,16,0v56H208V152a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,132.69V40a8,8,0,0,0-16,0v92.69L93.66,106.34a8,8,0,0,0-11.32,11.32Z"></path>
              </svg>
              {{ properties.primary_button_text | renderString }}
            </a>
            {% endif %}

            {% if properties.secondary_button_text %}
            <a href="{{ properties.secondary_button_link | shopUrl if properties.secondary_button_link.startsWith('/') else properties.secondary_button_link }}" class="action-btn action-btn-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
                <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"></path>
              </svg>
              {{ properties.secondary_button_text | renderString }}
            </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- designed by https://theme.mysellauth.com/ -->
<style>
.menu-cheat-section {
  position: relative;
  padding: 20px;
  background: #09090b;
  overflow: hidden;
}

.menu-container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
}

.menu-card {
  background: rgba(9, 9, 11, 0.8);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(247, 50, 52, 0.3);
  overflow: visible;
  position: relative;
}

.menu-plus-icon {
  position: absolute;
  width: 18px;
  height: 18px;
  color: #F73234;
  background: #09090b;
  z-index: 2;
}

@media (min-width: 640px) {
  .menu-plus-icon {
    width: 22px;
    height: 22px;
  }
}

.menu-plus-top-left { top: -10px; left: -10px; }
@media (min-width: 640px) { .menu-plus-top-left { top: -12px; left: -12px; } }

.menu-plus-top-right { top: -10px; right: -10px; }
@media (min-width: 640px) { .menu-plus-top-right { top: -12px; right: -12px; } }

.menu-plus-bottom-left { bottom: -10px; left: -10px; }
@media (min-width: 640px) { .menu-plus-bottom-left { bottom: -12px; left: -12px; } }

.menu-plus-bottom-right { right: -10px; bottom: -10px; }
@media (min-width: 640px) { .menu-plus-bottom-right { right: -12px; bottom: -12px; } }

.menu-content-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  z-index: 2;
  padding: 3rem 1.5rem;
  max-width: 800px;
  margin: 0 auto;
}

.menu-info-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  width: 100%;
}

.info-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: rgba(247, 50, 52, 0.1);
  border: 1px solid rgba(247, 50, 52, 0.3);
  border-radius: 9999px;
  color: #F73234;
  font-size: 0.875rem;
  font-weight: 600;
  width: fit-content;
}

.info-title {
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 800;
  color: #fafafa;
  line-height: 1.1;
  margin: 0;
}

.info-subtitle {
  font-size: 1.125rem;
  color: #a1a1aa;
  line-height: 1.6;
  margin: 0;
  max-width: 600px;
}

.features-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
  width: 100%;
  text-align: left;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.25rem;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 0.75rem;
  transition: all 0.3s ease;
}

.feature-item:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(247, 50, 52, 0.3);
  transform: translateY(-2px);
}

.feature-icon-style {
  color: #F73234;
  font-size: 1.25rem;
  flex-shrink: 0;
  margin-top: 0.125rem;
}

.feature-item svg {
  color: #F73234;
  flex-shrink: 0;
  margin-top: 0.125rem;
}

.feature-item > div {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.feature-title {
  font-size: 1rem;
  font-weight: 600;
  color: #fafafa;
}

.feature-desc {
  font-size: 0.875rem;
  color: #71717a;
}

.action-buttons {
  display: flex;
  gap: 1rem;
  margin-top: 1.5rem;
  width: 100%;
  justify-content: center;
}

.action-btn {
  flex: 0 1 200px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  border: none;
  text-decoration: none;
}

.action-btn-primary {
  background: linear-gradient(135deg, #F73234, #d92a2c);
  color: #ffffff;
  box-shadow: 0 10px 20px -5px rgba(247, 50, 52, 0.4);
}

.action-btn-primary:hover {
  background: linear-gradient(135deg, #ff3b3d, #F73234);
  transform: translateY(-2px);
  box-shadow: 0 15px 25px -5px rgba(247, 50, 52, 0.5);
  color: #ffffff;
}

.action-btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #fafafa;
}

.action-btn-secondary:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(247, 50, 52, 0.3);
  transform: translateY(-2px);
  color: #fafafa;
}

@media (max-width: 640px) {
  .menu-cheat-section {
    padding: 16px;
  }

  .menu-content-wrapper {
    padding: 2.5rem 1rem;
    gap: 2rem;
  }

  .features-list {
    grid-template-columns: 1fr;
  }

  .action-buttons {
    flex-direction: column;
    align-items: center;
  }
  
  .action-btn {
    width: 100%;
    flex: none;
  }
}
</style>
