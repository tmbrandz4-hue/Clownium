    <!--
      ✅ What changed (to fix unclickable group product cards):
      1) REMOVED ScrollReveal's [data-dsr]{visibility:hidden} and the library init (hidden layers often block clicks).
      2) Gave purely decorative absolute layers pointer-events:none and explicit z-index scoping so they never cover content.
      3) Tightened z-index stacking: header at 20, hero decor below content, component content above decor.
      4) Kept your design tokens/buttons but removed anything that could create invisible overlays.
      5) Left i18n intact, but safe.
    -->

    <script>
      // Active section highlighter (safe)
      document.addEventListener("DOMContentLoaded", () => {
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link");

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const id = entry.target.getAttribute("id");
              const link = document.querySelector(`.nav-link[href="#${id}"]`);
              if (entry.isIntersecting) {
                navLinks.forEach((l) => l.classList.remove("active"));
                link?.classList.add("active");
              }
            });
          },
          { root: null, threshold: 0.6 }
        );

        sections.forEach((section) => observer.observe(section));
      });
    </script>

