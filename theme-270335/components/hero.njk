    <!-- NEW/CHANGED CSS (safe) -->
    <style>
      :root {
        --brand-blue: #0018a8;
        --brand-blue-rgb: 0, 24, 168;
        --deep-blue: #001d3d;
        --deep-black: #000814;
      }

      /* ensure rotating word is visible */
      .typing-words { color: #fff !important; }

      /* SOLID dark-blue pill (no outline) used in hero data text */
      .pill-dark-blue {
        background-color: var(--brand-blue) !important;
        border: none !important;
        color: #ffffff;
      }

      /* Badges */
      .badge-dark-blue {
        background-color: rgba(var(--brand-blue-rgb), 0.10) !important;
        border: 1px solid rgba(var(--brand-blue-rgb), 0.60) !important;
        color: #ffffff;
      }
      .badge-dark-blue:hover,
      .badge-dark-blue:focus {
        background-color: rgba(var(--brand-blue-rgb), 0.16) !important;
        border-color: rgba(var(--brand-blue-rgb), 0.72) !important;
      }

      /* Primary CTA */
      .btn-dark-blue {
        background: linear-gradient(90deg, #0b1a49 0%, #1a3dd6 100%);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 24px rgba(26, 61, 214, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
      }
      .btn-dark-blue:hover { opacity: 1; transform: translateY(-2px); box-shadow: 0 12px 28px rgba(26, 61, 214, 0.35); }

      /* Join Discord: black button with dark-blue outline */
      .btn-black-outline-blue { background: #0a0a0a; color: #fff; border: 1px solid rgba(var(--brand-blue-rgb), 0.70); transition: all 0.2s ease-in-out; }
      .btn-black-outline-blue:hover { background: #101010; border-color: rgba(var(--brand-blue-rgb), 0.90); }

      /* Stats card gradient + border + soft glow */
      .card-gradient {
        background: linear-gradient(180deg, var(--deep-blue) 0%, var(--deep-black) 100%);
        border: 1px solid rgba(0, 64, 255, 0.18);
        border-radius: 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 0 0 1px rgba(0, 64, 255, 0.06) inset, 0 10px 30px rgba(0, 64, 255, 0.08);
      }
      .card-gradient::before {
        content: "";
        position: absolute;
        inset: -40% -20% auto -20%;
        height: 60%;
        background: radial-gradient(60% 80% at 50% 0%, rgba(0, 64, 255, 0.15), transparent 60%);
        pointer-events: none; /* never block */
      }
      .card-sheen { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(22,22,22,0.35), transparent); pointer-events: none; }

      /* Global blue glows across the black background (outside hero) */
      .glow-layer { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(300px 300px at 10% 18%, rgba(0, 64, 255, 0.08), transparent 60%), radial-gradient(250px 250px at 82% 14%, rgba(0, 64, 255, 0.07), transparent 60%), radial-gradient(350px 350px at 18% 80%, rgba(0, 64, 255, 0.07), transparent 60%), radial-gradient(225px 225px at 74% 78%, rgba(0, 64, 255, 0.06), transparent 60%), radial-gradient(275px 275px at 50% 55%, rgba(0, 64, 255, 0.05), transparent 65%); mix-blend-mode: screen; }

      /* keep app above the glow layer */
      #app { position: relative; z-index: 1; }

      /* NEW: make sure hero decorative absolute layers never eat clicks */
      .decor-abs { position: absolute; inset: 0; pointer-events: none; }

      /* NEW: establish clear stacking for main areas */
      header { position: sticky; top: 0; z-index: 20; }
      .components { position: relative; z-index: 10; }
      /* If you render a modal elsewhere, give it z-index: 40+ */

      /* REMOVE old [data-dsr] rule that hid elements and could block clicks */
      /* [data-dsr] { visibility: hidden; }  <-- deleted on purpose */
    </style>

    <script src="https://cdn.jsdelivr.net/npm/dom-i18n@1.2.0/dist/dom-i18n.min.js" crossorigin="anonymous"></script>

    <style id="translatable-styles">[data-translatable] { opacity: 0; }</style>

    <script>
      // i18n init (safe)
      document.addEventListener("DOMContentLoaded", function () {
        const lang = window.localStorage.getItem("language") || "en";
        window.i18n = domI18n({ languages: ["en", "es"], currentLanguage: lang, defaultLanguage: "en" });
        document.querySelectorAll(".language-button:not(." + lang + ")").forEach((obj) => obj.classList.add("opacity-50"));
        // We can now show the translatable content
        document.getElementById("translatable-styles")?.remove();
      });
      function setLanguage(lang) {
        i18n.changeLanguage(lang);
        window.localStorage.setItem("language", lang);
        document.querySelectorAll(".language-button:not(." + lang + ")").forEach((obj) => obj.classList.add("opacity-50"));
        document.querySelector(".language-button." + lang)?.classList.remove("opacity-50");
      }
    </script>

