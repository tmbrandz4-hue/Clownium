    <style>
      /* --- Modal layering fix --- */
      .modal-root { position: fixed; inset: 0; z-index: 50; display: none; }
      .modal-root[aria-modal="true"] { display: block; }
      .modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.6); z-index: 50; }
      .modal-panel { position: relative; z-index: 51; pointer-events: auto; }
      /* Ensure NO decorative layer can sit above modal */
      .glow-layer, .decor-abs, .card-sheen, .card-gradient::before { z-index: 0 !important; }
      /* Guard: never block clicks inside any component panels */
      .component > * { pointer-events: auto; }
      /* If any ancestor creates a stacking context (filter/transform), this keeps panels clickable */
      [data-stacking-context-fix] { isolation: isolate; }
    </style>
