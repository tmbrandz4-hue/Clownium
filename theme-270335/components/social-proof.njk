{% set sp = global.components['social-proof'] %}
{% set _spOrders = [] %}
{% if sp.enabled != false and product and liveStats and liveStats.latestOrders %}
  {% for order in liveStats.latestOrders %}
    {% if _spOrders.length < 8 %}
      {% if _spOrders.push(order) %}{% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if _spOrders.length %}
  <div
    x-data="socialProof({{ _spOrders.length }})"
    class="sa-social-proof fixed bottom-4 {{ 'right-4' if sp.position == 'bottom-right' else 'left-4' }} z-30 w-[calc(100vw-2rem)] max-w-xs"
    aria-live="polite"
  >
    {% for order in _spOrders %}
      <div
        x-show="visible && index === {{ loop.index0 }}"
        x-cloak
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-y-3"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 translate-y-2"
        @mouseenter="hold()"
        @mouseleave="release()"
        class="sa-social-proof-item relative rounded-card border border-theme bg-surface-raised shadow-modal p-3"
      >
        <div class="flex items-center gap-3 pr-6">
          {% if product.image_urls.length %}
            <img src="{{ product.image_urls[0] }}" alt="" class="size-11 shrink-0 rounded-input border border-theme object-cover" loading="lazy" />
          {% else %}
            <span class="size-11 shrink-0 rounded-input bg-accent-500/10 text-accent-500 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </span>
          {% endif %}
          <span class="min-w-0">
            <span class="block text-xs text-t-muted truncate">Someone {% if order.country_code %}<span x-text="'in ' + countryName('{{ order.country_code }}')">in {{ order.country_code }}</span> {% endif %}purchased</span>
            <span class="block text-sm font-medium text-t-primary truncate">{{ product.name }}</span>
            <span class="mt-0.5 flex items-center gap-1.5 text-xs">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-success shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="text-success font-medium">{{ 'feedback.verified' | t }}</span>
              <span class="text-t-muted" aria-hidden="true">&middot;</span>
              <span class="text-t-muted truncate" x-text="timeAgo('{{ order.completed_at }}')"></span>
            </span>
          </span>
        </div>
        <button type="button" @click="dismiss()" class="absolute top-2 right-2 size-6 flex items-center justify-center rounded-input text-t-muted hover:text-t-primary hover:bg-t-primary/5" aria-label="{{ 'product.dismiss_notifications' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    {% endfor %}
  </div>
{% endif %}
