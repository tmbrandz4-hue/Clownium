<section id="{{ componentId }}" class="component sa-page-cart py-section" data-component-id="{{ componentId }}" x-data="cartPage" x-init="appCartUi.hydrate()">
  <div class="wrap">
    {% render_snippet "section-header.njk",
      header_headline=properties.headline,
      header_title=properties.title,
      header_subtitle=properties.subtitle,
      header_align=properties.header_align,
      header_size='h1'
    %}

    <div x-show="appCartUi.loading" class="py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="inline-block text-accent-500 size-8 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
    </div>

    <div x-show="!appCartUi.loading && appCartUi.fullCart.length === 0" x-cloak class="py-16 text-center">
      <p class="text-t-muted" x-text="appCartUi.error ? appCartUi.error : '{{ 'cart.empty' | t | jsEscape }}'"></p>
      <a href="{{ '/products' | shopUrl }}" class="inline-flex items-center justify-center mt-5 px-5 py-2.5 text-sm font-medium rounded-btn bg-accent-500 text-on-accent hover:bg-accent-600 transition-colors duration-theme shadow-btn">
        {{ 'products.browse' | t }}
      </a>
    </div>

    <div class="flex flex-col lg:flex-row gap-6 items-start" x-show="!appCartUi.loading && appCartUi.fullCart.length > 0" x-cloak>
      <div class="sa-page-cart-items w-full lg:w-2/3 flex flex-col gap-3">
        <template x-if="appCartUi.messages.length">
          <div class="space-y-2">
            <template x-for="message in appCartUi.messages" :key="message">
              <p class="text-sm text-warning border border-theme rounded-input px-3 py-2 bg-warning/5" x-text="message"></p>
            </template>
          </div>
        </template>

        <template x-for="(cartItem, index) in appCartUi.fullCart" :key="index">
          <div class="sa-page-cart-item rounded-card border border-theme bg-surface shadow-card p-card">
            <div class="flex items-start gap-4">
              <div class="size-16 sm:size-20 shrink-0 rounded-input bg-t-primary/5 border border-theme overflow-hidden flex items-center justify-center">
                <template x-if="cartItem.product.image_url">
                  <img :src="cartItem.product.image_url" :alt="cartItem.product.name" class="size-full object-cover" />
                </template>
                <template x-if="!cartItem.product.image_url">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-t-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                </template>
              </div>

              <div class="min-w-0 flex-1">
                <a :href="'/product/' + cartItem.product.path" class="sa-page-cart-title font-medium text-t-primary hover:text-accent-500 transition-colors duration-theme block truncate" x-text="cartItem.product.name"></a>
                <p class="text-sm text-t-muted truncate" x-text="cartItem.variant.name"></p>
                <template x-if="cartItem.addons && cartItem.addons.length">
                  <div class="flex flex-wrap gap-1.5 mt-1.5">
                    <template x-for="addon in cartItem.addons" :key="addon.variantId">
                      <span class="inline-flex items-center gap-1 text-xs text-t-muted border border-theme rounded-badge px-2 py-0.5">
                        <span x-text="addon.product.name"></span>
                        <span class="text-t-primary" x-text="'+' + appCurrency.format(addon.variant.price, cartItem.product.currency)"></span>
                      </span>
                    </template>
                  </div>
                </template>

                <div class="flex items-center gap-4 mt-3">
                  <div class="input-stepper">
                    <button type="button" @click="appCartUi.changeQuantity(index, cartItem.quantity - 1)" class="!w-8" aria-label="{{ 'product.decrease_quantity' | t }}">−</button>
                    <span class="min-w-[2.25rem] flex items-center justify-center" x-text="cartItem.quantity"></span>
                    <button type="button" @click="appCartUi.changeQuantity(index, cartItem.quantity + 1)" class="!w-8" aria-label="{{ 'product.increase_quantity' | t }}">+</button>
                  </div>
                  <button type="button" @click="appCartUi.removeItem(index)" class="text-sm text-t-muted hover:text-error transition-colors duration-theme">
                    {{ 'common.remove' | t }}
                  </button>
                </div>
              </div>

              <div class="text-end shrink-0">
                <p class="sa-page-cart-price font-semibold text-t-primary" x-text="appCurrency.format(appCartUi.getItemTotal(cartItem), cartItem.product.currency)"></p>
                <p x-cloak x-show="appCartUi.getAppliedVolumeDiscount(cartItem)" class="text-xs text-t-muted line-through mt-0.5" x-text="appCurrency.format(appCartUi.getItemBaseTotal(cartItem), cartItem.product.currency)"></p>
                <p class="text-xs text-t-muted mt-0.5" x-show="cartItem.quantity > 1" x-text="appCurrency.format(appCartUi.getItemUnitPrice(cartItem), cartItem.product.currency) + ' each'"></p>
                <p x-cloak x-show="appCartUi.getAppliedVolumeDiscount(cartItem)" class="text-xs text-success mt-0.5" x-text="appCartUi.getAppliedVolumeDiscount(cartItem) ? appCartUi.getAppliedVolumeDiscount(cartItem).percentage + '% volume discount' : ''"></p>
              </div>
            </div>
          </div>
        </template>

        <template x-if="appCartUi.quantityDeals.length">
          <div class="rounded-card border border-theme bg-accent-500/5 p-4 space-y-1">
            <p class="text-sm font-medium text-t-primary">{{ 'product.quantity_deals' | t }}</p>
            <template x-for="deal in appCartUi.quantityDeals" :key="deal.id">
              <p class="text-sm text-t-muted" x-text="deal.name + ' — buy ' + deal.buy_quantity + ', get ' + deal.discounted_quantity + ' at ' + deal.percentage + '% off'"></p>
            </template>
          </div>
        </template>
      </div>

      <div class="w-full lg:w-1/3 lg:sticky lg:top-24">
        <div class="rounded-card border border-theme bg-surface shadow-card p-card space-y-4">
          <h2 class="text-h4 font-heading text-t-primary">{{ 'cart.summary' | t }}</h2>

          <div class="space-y-1 border-t border-theme pt-4">
            <div class="flex items-center justify-between">
              <span class="text-t-muted text-sm">{{ 'common.subtotal' | t }}</span>
              <span class="font-semibold text-t-primary" :class="appCartUi.discountTotal > 0 ? 'text-sm' : 'text-lg'" x-text="appCurrency.format(appCartUi.subtotal, appCartUi.currency)"></span>
            </div>
            <template x-for="deal in appCartUi.quantityDeals" :key="'qd-' + deal.id">
              <div x-show="appCartUi.getQuantityDealDiscount(deal) > 0" class="flex items-center justify-between">
                <span class="text-sm text-t-muted" x-text="deal.name"></span>
                <span class="text-sm text-success" x-text="'-' + appCurrency.format(appCartUi.getQuantityDealDiscount(deal), appCartUi.currency)"></span>
              </div>
            </template>
            <template x-for="offer in appCartUi.bundleOffers" :key="'bo-' + offer.id">
              <div x-show="appCartUi.getBundleDiscount(offer) > 0" class="flex items-center justify-between">
                <span class="text-sm text-t-muted" x-text="offer.name"></span>
                <span class="text-sm text-success" x-text="'-' + appCurrency.format(appCartUi.getBundleDiscount(offer), appCartUi.currency)"></span>
              </div>
            </template>
            <div x-cloak x-show="appCartUi.discountTotal > 0" class="flex items-center justify-between border-t border-theme pt-2 mt-2">
              <span class="text-t-muted text-sm">{{ 'common.total' | t }}</span>
              <span class="text-lg font-semibold text-t-primary" x-text="appCurrency.format(appCartUi.total, appCartUi.currency)"></span>
            </div>
          </div>
          <p class="text-xs text-t-muted">{{ 'cart.tax_notice' | t }}</p>

          {% if altcha %}
            <altcha-widget
              challengejson='{{ altcha | json }}'
              auto="onload"
              hidelogo
              hidefooter
              x-ref="altcha"
            ></altcha-widget>
          {% endif %}

          <button
            type="button"
            @click="submitCheckout()"
            :disabled="appCartUi.submitting{% if altcha %} || !altchaPayload{% endif %}"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 font-medium rounded-btn bg-accent-500 text-on-accent hover:bg-accent-600 transition-colors duration-theme disabled:opacity-50 shadow-btn"
          >
            <span x-text="appCartUi.submitting ? '{{ 'cart.processing' | t | jsEscape }}' : '{{ 'cart.checkout' | t | jsEscape }}'"></span>
          </button>

          <p x-show="appCartUi.error" x-cloak x-text="appCartUi.error" class="text-sm text-error"></p>

          <button type="button" @click="appCartUi.clear()" class="w-full text-center text-sm text-t-muted hover:text-error transition-colors duration-theme">
            {{ 'cart.clear' | t }}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('cartPage', () => ({
      altchaPayload: null,

      init() {
        {% if altcha %}
          this.$nextTick(() => {
            if (this.$refs.altcha) {
              this.$refs.altcha.addEventListener('statechange', (event) => {
                if (event.detail.state === 'verified') {
                  this.altchaPayload = event.detail.payload;
                }
              });
            }
          });
        {% endif %}
      },

      async submitCheckout() {
        let captcha = null;

        {% if altcha %}
          if (this.altchaPayload) {
            captcha = { altcha: this.altchaPayload };
          }
        {% elif shop.recaptcha_key %}
          const token = await new Promise((resolve) => {
            grecaptcha.ready(async () => {
              resolve(await grecaptcha.execute('{{ shop.recaptcha_key }}', { action: 'checkout' }));
            });
          });
          captcha = { recaptchaToken: token };
        {% endif %}

        window.alpineApp.appCartUi.checkout(captcha);
      },
    }));
  });
</script>
