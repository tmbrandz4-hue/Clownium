<section id="{{ componentId }}" class="component sa-page-customer-reseller py-section" data-component-id="{{ componentId }}">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-8 items-start">
      {% render_snippet "customer-sidebar.njk" %}

      <div class="min-w-0">
        {% render_snippet "customer-header.njk",
          ch_title=properties.title,
          ch_subtitle=properties.subtitle
        %}

        {% if reseller_status == 'approved' %}
          <div class="sa-page-customer-reseller-stats grid grid-cols-2 gap-grid-gap {{ 'lg:grid-cols-4' if reseller_tier else 'sm:grid-cols-3' }}">
            {% if reseller_tier %}
              <div class="sa-page-customer-reseller-stat rounded-card border border-theme bg-surface shadow-card p-4 sm:p-5">
                <span class="size-9 rounded-input bg-accent-500/10 text-accent-500 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="5" y1="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                </span>
                <p class="text-2xl font-semibold text-t-primary mt-3 truncate">{{ reseller_tier.discount_percentage }}%</p>
                <p class="text-sm text-t-muted mt-0.5">{{ 'common.discount' | t }}</p>
              </div>
            {% endif %}

            <div class="sa-page-customer-reseller-stat rounded-card border border-theme bg-surface shadow-card p-4 sm:p-5">
              <span class="size-9 rounded-input bg-accent-500/10 text-accent-500 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
              </span>
              <p class="text-2xl font-semibold text-t-primary mt-3 truncate">
                <span x-text="appCurrency.format({{ reseller_total_spent_usd }}, 'USD')">{{ formatPrice(reseller_total_spent_usd, 'USD') }}</span>
              </p>
              <p class="text-sm text-t-muted mt-0.5">{{ 'reseller.lifetime_spent' | t }}</p>
            </div>

            <div class="sa-page-customer-reseller-stat rounded-card border border-theme bg-surface shadow-card p-4 sm:p-5">
              <span class="size-9 rounded-input bg-accent-500/10 text-accent-500 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"/><path d="m7.5 4.27 9 5.15"/></svg>
              </span>
              <p class="text-2xl font-semibold text-t-primary mt-3 truncate">{{ reseller_total_completed }}</p>
              <p class="text-sm text-t-muted mt-0.5">{{ 'customer.orders' | t }}</p>
            </div>

            <a href="{{ '/customer/balance' | shopUrl }}" class="sa-page-customer-reseller-stat rounded-card border border-theme bg-surface shadow-card p-4 sm:p-5 hover:border-accent-500/50 transition-colors duration-theme">
              <span class="size-9 rounded-input bg-accent-500/10 text-accent-500 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
              </span>
              <p class="text-2xl font-semibold text-t-primary mt-3 truncate">
                <span x-text="appCurrency.format({{ shop_customer.balance }}, 'USD')">{{ formatPrice(shop_customer.balance, 'USD') }}</span>
              </p>
              <p class="text-sm text-t-muted mt-0.5">{{ 'common.balance' | t }}</p>
            </a>
          </div>

          <div class="sa-page-customer-reseller-items grid gap-grid-gap mt-grid-gap">
            <div class="rounded-card border border-theme bg-surface shadow-card p-5">
              <div class="flex items-start gap-4">
                {% if reseller_tier and reseller_tier.image_url %}
                  <img src="{{ reseller_tier.image_url }}" alt="{{ reseller_tier.name }}" class="size-14 shrink-0 rounded-input border border-theme object-cover" loading="lazy" />
                {% endif %}
                <div class="min-w-0">
                  <h2 class="text-sm font-medium text-t-primary">Your tier{% if reseller_tier %}: {{ reseller_tier.name }}{% endif %}</h2>
                  <p class="text-sm text-t-muted mt-1">You buy products at your tier discount, paid from your store balance.</p>
                  {% if reseller_next_tier %}
                    <p class="text-xs text-t-muted mt-3">
                      {{ 'reseller.next_tier' | t }}
                      {% if reseller_next_tier.image_url %}<img src="{{ reseller_next_tier.image_url }}" alt="{{ reseller_next_tier.name }}" class="inline-block size-5 rounded-badge border border-theme object-cover align-middle mx-0.5" loading="lazy" />{% endif %}
                      <span class="font-medium text-t-primary">{{ reseller_next_tier.name }}</span> ({{ reseller_next_tier.discount_percentage }}% discount):
                      {% if reseller_next_tier.min_spent_usd %}spend {{ formatPrice(reseller_next_tier.min_spent_usd, 'USD') }}{% endif %}
                      {% if reseller_next_tier.min_spent_usd and reseller_next_tier.min_sales_count %} and {% endif %}
                      {% if reseller_next_tier.min_sales_count %}{{ reseller_next_tier.min_sales_count }} orders{% endif %}
                    </p>
                  {% endif %}
                </div>
              </div>
            </div>

            <div class="rounded-card border border-theme bg-surface shadow-card">
              <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3.5 border-b border-theme">
                <h2 class="text-sm font-medium text-t-primary">{{ 'customer.order_history' | t }}</h2>
                <a href="{{ '/customer/invoices' | shopUrl }}?reseller=1" class="sa-page-customer-reseller-link inline-flex items-center gap-1 text-sm font-medium text-accent-500 hover:text-accent-600 transition-colors duration-theme">
                  {{ 'common.view_all' | t }}
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>
              <div class="p-4 sm:p-5">
                {% if latest_reseller_invoice %}
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="min-w-0">
                      <p class="font-medium text-t-primary truncate">
                        {% if latest_reseller_invoice.items %}
                          {% if latest_reseller_invoice.items[0].custom_name %}
                            {{ latest_reseller_invoice.items[0].custom_name }}
                          {% else %}
                            {{ latest_reseller_invoice.items[0].product.name }}
                            {% if latest_reseller_invoice.items[0].variant and latest_reseller_invoice.items[0].product.name != latest_reseller_invoice.items[0].variant.name %}
                              ({{ latest_reseller_invoice.items[0].variant.name }})
                            {% endif %}
                          {% endif %}

                          {% if latest_reseller_invoice.items.length > 1 %}
                            & {{ latest_reseller_invoice.items.length - 1 }} more
                          {% endif %}
                        {% else %}
                          {{ 'feedback.deleted_product' | t }}
                        {% endif %}
                      </p>
                      <p class="text-xs text-t-muted mt-0.5">
                        Invoice <a href="{{ latest_reseller_invoice.url }}" target="_blank" class="text-accent-500 hover:text-accent-600 transition-colors duration-theme">#{{ latest_reseller_invoice.unique_id }}</a> · {{ latest_reseller_invoice.created_at | formatDate }}
                      </p>
                    </div>
                    <a href="{{ latest_reseller_invoice.url }}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-btn border border-theme text-t-muted hover:text-t-primary hover:bg-t-primary/5 transition-colors duration-theme">
                      {{ 'common.view_invoice' | t }}
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    </a>
                  </div>
                {% else %}
                  <p class="text-sm text-t-muted">{{ 'reseller.no_orders' | t }}</p>
                {% endif %}
              </div>
            </div>

            <div class="grid gap-grid-gap sm:grid-cols-2">
              <div class="rounded-card border border-theme bg-surface shadow-card p-5 flex flex-col">
                <h2 class="text-sm font-medium text-t-primary">{{ 'reseller.api' | t }}</h2>
                <p class="text-sm text-t-muted mt-1 grow">Buy products and check your balance from any platform via the API.</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <button
                    type="button"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-btn border border-accent-500/30 bg-accent-500/[0.06] text-accent-500 hover:bg-accent-500/10 transition-colors duration-theme"
                    @click="appReseller.openApiModal()"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
                    {{ 'reseller.manage_api_key' | t }}
                  </button>
                  {% if reseller_api_docs_url %}
                    <a
                      href="{{ reseller_api_docs_url }}"
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-btn border border-theme text-t-muted hover:text-t-primary hover:bg-t-primary/5 transition-colors duration-theme"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                      {{ 'common.view_docs' | t }}
                    </a>
                  {% endif %}
                </div>
              </div>

              <div class="rounded-card border border-theme bg-surface shadow-card p-5 flex flex-col">
                <h2 class="text-sm font-medium text-t-primary">{{ 'reseller.dynamic_delivery' | t }}</h2>
                <p class="text-sm text-t-muted mt-1 grow">Resell on your own SellAuth shop with automatic delivery, paid from your balance.</p>
                <div class="mt-3">
                  <button
                    type="button"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-btn border border-accent-500/30 bg-accent-500/[0.06] text-accent-500 hover:bg-accent-500/10 transition-colors duration-theme"
                    @click="appReseller.openDeliveryModal()"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                    {{ 'reseller.manage_delivery' | t }}
                  </button>
                </div>
              </div>
            </div>

            <div class="rounded-card border border-theme bg-surface shadow-card">
              <div class="px-4 sm:px-5 py-3.5 border-b border-theme">
                <h2 class="text-sm font-medium text-t-primary">{{ 'reseller.catalog' | t }}</h2>
                <p class="text-xs text-t-muted mt-0.5">Products available to you, with your discounted price and the dynamic delivery URL for your own shop.</p>
              </div>
              {% if reseller_catalog.length > 0 %}
                <div class="overflow-x-auto">
                  <table class="w-full text-left text-sm text-t-primary">
                    <thead>
                      <tr class="border-b border-theme">
                        <th scope="col" class="pl-4 sm:pl-5 pr-0 py-3 w-12"><span class="sr-only">{{ 'common.image' | t }}</span></th>
                        <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'common.product' | t }}</th>
                        <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'common.price' | t }}</th>
                        <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'common.price' | t }}</th>
                        <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'common.stock' | t }}</th>
                        <th scope="col" class="px-4 sm:px-5 py-3 text-xs font-medium text-t-muted uppercase tracking-wide">{{ 'reseller.delivery_url' | t }}</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-theme">
                      {% for product in reseller_catalog %}
                        {% for variant in product.variants %}
                          <tr>
                            <td class="pl-4 sm:pl-5 pr-0 py-2.5 w-12">
                              {% if product.image_urls | length %}
                                <img src="{{ product.image_urls[0] }}" alt="{{ product.name }}" class="size-9 rounded-input border border-theme object-cover" loading="lazy" />
                              {% else %}
                                <span class="flex items-center justify-center size-9 rounded-input bg-accent-500/5 text-accent-500">
                                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                                </span>
                              {% endif %}
                            </td>
                            <td class="px-4 sm:px-5 py-2.5">
                              <a href="{{ ('/product/' + product.path) | shopUrl }}" class="font-medium hover:text-accent-500 transition-colors duration-theme">{{ product.name }}</a>
                              {% if product.variants.length > 1 %}
                                <p class="text-xs text-t-muted mt-0.5">{{ variant.name }}</p>
                              {% endif %}
                            </td>
                            <td class="px-4 sm:px-5 py-2.5 whitespace-nowrap text-t-muted {{ 'line-through' if variant.discount_percentage > 0 }}">
                              <span x-text="appCurrency.format({{ variant.price }}, '{{ product.currency }}')">{{ formatPrice(variant.price, product.currency) }}</span>
                            </td>
                            <td class="px-4 sm:px-5 py-2.5 whitespace-nowrap">
                              <span class="font-medium" x-text="appCurrency.format({{ variant.reseller_price }}, '{{ product.currency }}')">{{ formatPrice(variant.reseller_price, product.currency) }}</span>
                              {% if variant.discount_percentage > 0 %}
                                <span class="text-xs text-success ml-1">-{{ variant.discount_percentage }}%</span>
                              {% endif %}
                            </td>
                            <td class="px-4 sm:px-5 py-2.5 whitespace-nowrap text-t-muted">
                              {% if variant.stock == -1 %}<span aria-label="{{ 'common.unlimited' | t }}">&infin;</span>{% else %}{{ variant.stock }}{% endif %}
                            </td>
                            <td class="px-4 sm:px-5 py-2.5 whitespace-nowrap">
                              {% if variant.dynamic_url %}
                                <button
                                  type="button"
                                  x-data="{ copied: false }"
                                  @click="navigator.clipboard.writeText('{{ variant.dynamic_url }}'); copied = true; setTimeout(() => copied = false, 2000)"
                                  class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-btn border border-theme text-t-muted hover:text-t-primary hover:bg-t-primary/5 transition-colors duration-theme"
                                >
                                  <svg x-show="!copied" xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                                  <svg x-show="copied" x-cloak class="size-3.5 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-4-4"/></svg>
                                  <span x-text="copied ? '{{ 'common.copied_short' | t | jsEscape }}' : '{{ 'common.copy' | t | jsEscape }}'">{{ 'common.copy' | t }}</span>
                                </button>
                              {% else %}
                                <span class="text-t-muted">—</span>
                              {% endif %}
                            </td>
                          </tr>
                        {% endfor %}
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% else %}
                <p class="text-sm text-t-muted p-4 sm:p-5">{{ 'reseller.no_products' | t }}</p>
              {% endif %}
              {% if reseller_catalog_paginator.last_page > 1 %}
                <div class="px-4 sm:px-5 pb-4">
                  {% render_snippet "pagination.njk", paginator=reseller_catalog_paginator %}
                </div>
              {% endif %}
            </div>
          </div>

          {% render_snippet "reseller-api-modal.njk" %}
          {% render_snippet "reseller-delivery-modal.njk" %}
        {% elif reseller_status == 'suspended' %}
          <div class="sa-page-customer-reseller-suspended rounded-card border border-theme bg-surface shadow-card p-6 sm:p-10">
            <div class="flex flex-col items-center text-center max-w-xl mx-auto">
              <span class="size-12 rounded-input border border-error/25 bg-error/10 text-error flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <h2 class="text-lg font-semibold text-t-primary mt-4">{{ 'reseller.suspended_title' | t }}</h2>
              <p class="text-sm text-t-muted mt-2">Your reseller access has been suspended by the store. Your API keys and dynamic delivery are disabled. Contact the store if you think this is a mistake.</p>
            </div>
          </div>
        {% elif reseller_status == 'applied' %}
          <div class="sa-page-customer-reseller-applied rounded-card border border-theme bg-surface shadow-card p-6 sm:p-10">
            <div class="flex flex-col items-center text-center max-w-xl mx-auto">
              <span class="size-12 rounded-input bg-accent-500/10 text-accent-500 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg>
              </span>
              <h2 class="text-lg font-semibold text-t-primary mt-4">{{ 'reseller.application_under_review' | t }}</h2>
              <p class="text-sm text-t-muted mt-2">Thanks for applying to the reseller program. We're reviewing your application and you'll receive an email as soon as a decision is made.</p>
              <span class="inline-flex items-center gap-1.5 mt-5 px-3 py-1 text-xs font-medium rounded-badge border border-accent-500/30 bg-accent-500/[0.06] text-accent-500">
                <span class="size-1.5 rounded-full bg-accent-500 animate-pulse"></span>
                {{ 'reseller.pending_review' | t }}
              </span>
            </div>
          </div>
        {% else %}
          <div class="rounded-card border border-theme bg-surface shadow-card p-6 sm:p-10">
            <div class="flex flex-col items-center text-center max-w-xl mx-auto">
              <span class="size-12 rounded-input bg-accent-500/10 text-accent-500 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m15 9-6 6"/><path d="M9 9h.01"/><path d="M15 15h.01"/></svg>
              </span>
              <h2 class="text-lg font-semibold text-t-primary mt-4">{{ properties.program_title | renderString if properties.program_title else 'Reseller program' }}</h2>
              {% if reseller_status == 'rejected' %}
                <p class="text-sm text-t-muted mt-2">Your previous application was not approved.{% if reseller_enrollment_mode == 'application' %} You can apply again below.{% endif %}</p>
              {% else %}
                <p class="text-sm text-t-muted mt-2">{{ properties.program_text | renderString if properties.program_text else 'Buy products at a discount using your balance and resell them on your own store.' }}</p>
              {% endif %}
              {% if reseller_enrollment_mode != 'application' %}
                <p class="text-sm text-t-muted mt-1">{{ properties.contact_text | renderString if properties.contact_text else 'Please contact us to enroll in the reseller program.' }}</p>
                {% if properties.contact_button_text %}
                  <a href="{{ (properties.contact_button_link if properties.contact_button_link else '/contact') | shopUrl }}" class="inline-flex items-center justify-center px-4 py-2 mt-5 text-sm font-medium rounded-btn bg-accent-500 text-on-accent hover:bg-accent-600 transition-colors duration-theme shadow-btn">
                    {{ properties.contact_button_text | renderString }}
                  </a>
                {% endif %}
              {% endif %}
            </div>

            {% if reseller_public_tiers.length > 0 %}
              <div class="flex flex-wrap justify-center gap-3 mt-8">
                {% for tier in reseller_public_tiers %}
                  <div class="w-full sm:w-52 rounded-input border border-theme bg-t-primary/[0.02] p-4 text-center">
                    {% if tier.image_url %}
                      <img src="{{ tier.image_url }}" alt="{{ tier.name }}" class="size-12 mx-auto rounded-input border border-theme object-cover mb-2" loading="lazy" />
                    {% endif %}
                    <p class="text-sm font-medium text-t-primary">{{ tier.name }}</p>
                    <p class="text-lg font-semibold text-accent-500 mt-1">{{ tier.discount_percentage }}%</p>
                    <p class="text-xs text-t-muted mt-1">
                      discount
                      {%- if tier.min_spent_usd %} &middot; {{ formatPrice(tier.min_spent_usd, 'USD') }} spent{% endif %}
                      {%- if tier.min_sales_count %} &middot; {{ tier.min_sales_count }} orders{% endif %}
                    </p>
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            {% if reseller_enrollment_mode == 'application' %}
              <form class="max-w-md mx-auto mt-8" @submit.prevent="appReseller.apply()">
                <label class="text-sm text-t-primary">
                  {{ reseller_application_prompt if reseller_application_prompt else 'Tell us about your store and how you plan to resell.' }}
                </label>
                <textarea
                  rows="4"
                  maxlength="2000"
                  x-model="appReseller.applicationAnswer"
                  class="input w-full mt-2"
                ></textarea>
                <p class="text-sm text-error mt-2" x-show="appReseller.applyError" x-text="appReseller.applyError"></p>
                <button
                  type="submit"
                  class="relative w-full inline-flex items-center justify-center px-4 py-2 mt-3 text-sm font-medium rounded-btn bg-accent-500 text-on-accent hover:enabled:bg-accent-600 transition-colors duration-theme shadow-btn disabled:opacity-50 disabled:pointer-events-none"
                  :disabled="appReseller.applyLoading"
                >
                  <span :class="appReseller.applyLoading ? 'opacity-0' : 'opacity-100'">{{ 'reseller.submit_application' | t }}</span>
                  <template x-if="appReseller.applyLoading">
                    <span class="absolute inset-0 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                    </span>
                  </template>
                </button>
              </form>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
