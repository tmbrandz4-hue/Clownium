<section class="social-proof component" data-component-id="{{ componentId }}">
  <style>
    /* Base styling */
    .social-proof {
      --ink-soft: rgba(255,255,255,.9);
      --ink-dim: rgba(255,255,255,.6);
      --hair: rgba(255,255,255,.1);
      --card-bg: rgba(255,255,255,.04);
      color: #fff;
      padding: 5rem 0 4rem;
      background: radial-gradient(800px 400px at 50% -200px, rgba(255,255,255,.05), transparent 60%), #000;
      position: relative;
      overflow: hidden;
    }

    .social-proof h2 {
      text-align: center;
      font-weight: 900;
      font-size: clamp(2rem,6vw,3rem);
      margin-bottom: .8rem;
      background: linear-gradient(90deg, #fff, #aaa);
      -webkit-background-clip: text;
      color: transparent;
      text-shadow: 0 0 10px rgba(255,255,255,.25);
    }

    .social-proof .lead {
      text-align: center;
      color: var(--ink-dim);
      margin-bottom: 2.4rem;
      font-size: 1.1rem;
      text-shadow: 0 0 6px rgba(255,255,255,.2);
    }

    /* Scroll animation */
    @keyframes scroll-left { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    @keyframes scroll-right { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }

    .scroll-container {
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      margin-bottom: 2rem;
    }

    .scroll-content {
      display: flex;
      gap: 1rem;
      width: fit-content;
    }

    .scroll-left .scroll-content { animation: scroll-left 60s linear infinite; }
    .scroll-right .scroll-content { animation: scroll-right 60s linear infinite; }
    .scroll-content:hover { animation-play-state: paused; }

    /* Review card styling */
    .review-card {
      flex-shrink: 0;
      width: 320px;
      background: var(--card-bg);
      border: 1px solid var(--hair);
      border-radius: 18px;
      padding: 1.4rem;
      box-shadow: 0 12px 32px rgba(0,0,0,.6), 0 0 12px rgba(255,255,255,.05);
      transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    }

    .review-card:hover {
      transform: translateY(-5px);
      border-color: rgba(255,255,255,.25);
      box-shadow: 0 16px 40px rgba(0,0,0,.7), 0 0 18px rgba(255,255,255,.15);
    }

    .head {
      display: flex;
      align-items: center;
      gap: .9rem;
      margin-bottom: .6rem;
    }

    .avatar {
      width: 48px;
      height: 48px;
      background: #000;
      border-radius: 12px;
      flex-shrink: 0;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.08), 0 0 10px rgba(255,255,255,.1);
    }

    .meta .name { font-weight: 800; color: #fff; text-shadow: 0 0 8px rgba(255,255,255,.25); }
    .meta .role { color: var(--ink-dim); font-size: .9rem; font-weight: 600; }
    .text { color: var(--ink-soft); line-height: 1.6; margin-top: .5rem; font-size: .95rem; text-shadow: 0 0 8px rgba(255,255,255,.1); }
  </style>

  <div class="container mx-auto px-4">
    {% if properties.title %}
      <h2>{{ properties.title | renderString }}</h2>
    {% else %}
      <h2>What people say about <span class="brand">Your Brand</span></h2>
    {% endif %}
    {% if properties.subtitle %}
      <p class="lead">{{ properties.subtitle | renderString }}</p>
    {% else %}
      <p class="lead">Join our community at <strong><a href="https://discord.gg/2dDR3fg4Ry" target="_blank" style="color: inherit; text-decoration: underline;">https://discord.gg/2dDR3fg4Ry</a></strong></p>
    {% endif %}

    <div class="flex flex-col gap-4">
      <!-- Top row scroll-left -->
      <div class="scroll-container scroll-left">
        <div class="scroll-content">
          {% for _ in range(3) %}
            {% for feedback in feedbacks.slice(0, properties.amount) %}
              <div class="review-card">
                {% render_snippet "feedback-card.njk", feedback=feedback %}
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>

      <!-- Bottom row scroll-right -->
      <div class="scroll-container scroll-right">
        <div class="scroll-content">
          {% for _ in range(3) %}
            {% for feedback in feedbacks.slice(0, properties.amount) %}
              <div class="review-card">
                {% render_snippet "feedback-card.njk", feedback=feedback %}
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var block = document.querySelector('[data-component-id="{{ componentId }}"] .scroll-container');
      if (!block) return;
      var observer = new IntersectionObserver(function(entries, observer) {
        entries.forEach(function(entry) {
          if(entry.isIntersecting){
            entry.target.classList.add('reveal-up');
            observer.unobserve(entry.target);
          }
        });
      }, {threshold: 0.15});
      observer.observe(block);
    });
  </script>
</section>