{% set statusStyles = {
  'pending': 'bg-warning/10 text-warning border-warning/25',
  'open': 'bg-accent-500/10 text-accent-500 border-accent-500/25',
  'closed': 'bg-success/10 text-success border-success/25'
} %}

{% set statusLabels = {
  'pending': 'Awaiting your response',
  'open': 'Awaiting support response',
  'closed': 'Closed'
} %}

<section id="{{ componentId }}" class="component sa-page-customer-tickets py-section" data-component-id="{{ componentId }}">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-8 items-start">
      {% render_snippet "customer-sidebar.njk" %}

      <div class="min-w-0">
        {% render_snippet "customer-header.njk",
          ch_title=properties.title,
          ch_subtitle=properties.subtitle
        %}

        {% if properties.show_info !== false %}
          <div class="flex items-start gap-2.5 rounded-card border border-accent-500/25 bg-accent-500/[0.06] p-3.5 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-accent-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <p class="text-sm text-t-primary">
              Open a new ticket from the <a href="{{ '/customer/invoices' | shopUrl }}" class="font-medium text-accent-500 hover:text-accent-600 transition-colors duration-theme">orders</a> page using the "Open ticket" button next to an order.
            </p>
          </div>
        {% endif %}

        {% if tickets.length > 0 %}
          <div class="sa-page-customer-tickets-items rounded-card border border-theme bg-surface shadow-card divide-y divide-theme">
            {% for ticket in tickets %}
              {% set statusClass = (statusStyles[ticket.status] if statusStyles[ticket.status] else 'bg-t-primary/5 text-t-muted border-theme') %}
              <div class="sa-page-customer-tickets-item p-4 sm:p-5">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <a href="{{ ('/customer/tickets/' ~ ticket.id) | shopUrl }}" class="sa-page-customer-tickets-title block font-medium text-t-primary truncate hover:text-accent-500 transition-colors duration-theme">
                      {{ ticket.subject }}
                    </a>
                    <p class="text-xs text-t-muted mt-1">
                      <a href="{{ ('/customer/tickets/' ~ ticket.id) | shopUrl }}" class="text-accent-500 hover:text-accent-600 transition-colors duration-theme">#{{ ticket.id }}</a>
                      {% if ticket.last_message %}
                        · <span class="text-t-primary">{{ 'You' if ticket.last_message.sender_type == 'shop_customer' else 'Support' }}:</span>
                        {{ ticket.last_message.content | truncate(90) }}
                      {% endif %}
                    </p>
                  </div>
                  <span class="sa-page-customer-tickets-badge inline-flex items-center px-2.5 py-1 rounded-badge border text-xs font-medium shrink-0 {{ statusClass }}">
                    {% if ticket.status in statusLabels %}
                      {{ statusLabels[ticket.status] }}
                    {% else %}
                      <span class="capitalize">{{ ticket.status | replace('_', ' ') }}</span>
                    {% endif %}
                  </span>
                </div>
                <div class="flex flex-wrap items-center gap-2 mt-3">
                  <a href="{{ ('/customer/tickets/' ~ ticket.id) | shopUrl }}" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-btn border border-accent-500/30 bg-accent-500/[0.06] text-accent-500 hover:bg-accent-500/10 transition-colors duration-theme">
                    {{ 'ticket.view' | t }}
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                  {% if ticket.invoice %}
                    <a href="{{ ticket.invoice.url }}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-btn border border-theme text-t-muted hover:text-t-primary hover:bg-t-primary/5 transition-colors duration-theme">
                      {{ 'common.view_invoice' | t }}
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    </a>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="rounded-card border border-theme bg-surface shadow-card p-10 text-center">
            <span class="size-10 rounded-input bg-t-primary/5 text-t-muted inline-flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
            </span>
            <p class="font-medium text-t-primary mt-3">{{ properties.empty_text | renderString if properties.empty_text else 'No tickets yet' }}</p>
            <p class="text-sm text-t-muted mt-1">{{ 'ticket.empty_hint' | t }}</p>
          </div>
        {% endif %}

        {% if tickets_paginator.last_page > 1 %}
          {% render_snippet "pagination.njk", paginator=tickets_paginator %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
