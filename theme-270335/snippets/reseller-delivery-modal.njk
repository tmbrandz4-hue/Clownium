<div
  x-show="appReseller.ddModalIsOpen"
  x-cloak
  class="sa-reseller-delivery-modal fixed inset-0 z-50 overflow-y-auto"
  aria-labelledby="reseller-delivery-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 text-center">
    <div
      x-show="appReseller.ddModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="appReseller.closeDeliveryModal()"
      class="fixed inset-0 transition-opacity [background-color:var(--cl-overlay)]"
      aria-hidden="true"
    ></div>

    <div
      x-show="appReseller.ddModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      class="inline-block w-full max-w-xl p-6 my-8 overflow-hidden text-left align-middle transition-all transform border border-theme rounded-card bg-surface-raised shadow-modal text-t-primary"
    >
      <div class="flex items-start justify-between gap-4">
        <h3 id="reseller-delivery-modal-title" class="text-h4 font-heading truncate">
          {{ 'reseller.dynamic_delivery' | t }}
        </h3>

        <button @click="appReseller.closeDeliveryModal()" class="text-t-muted focus:outline-none hover:text-t-primary transition-colors duration-theme">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <p class="text-sm text-t-muted mt-2">Sell these products on your own SellAuth shop. Each sale is paid from your balance here and delivered to your customer automatically.</p>

      <ol class="mt-4 p-4 rounded-input border border-theme bg-t-primary/[0.02] space-y-2.5">
        <li class="flex items-start gap-2.5">
          <span class="size-5 shrink-0 rounded-full bg-accent-500/10 text-accent-500 text-[11px] font-semibold flex items-center justify-center">1</span>
          <span class="text-sm text-t-muted">Save your shop's webhook secret below and enable dynamic delivery.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="size-5 shrink-0 rounded-full bg-accent-500/10 text-accent-500 text-[11px] font-semibold flex items-center justify-center">2</span>
          <span class="text-sm text-t-muted">{{ "reseller.dd_copy_hint" | t }}</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="size-5 shrink-0 rounded-full bg-accent-500/10 text-accent-500 text-[11px] font-semibold flex items-center justify-center">3</span>
          <span class="text-sm text-t-muted">Paste it into your variant's Dynamic URL field on your own shop.</span>
        </li>
      </ol>

      <div class="mt-5">
        <label for="reseller-webhook-secret" class="block text-sm font-medium text-t-primary mb-1">{{ 'reseller.webhook_secret' | t }}</label>
        <input
          id="reseller-webhook-secret"
          type="password"
          autocomplete="off"
          placeholder="{{ 'Enter a new secret to replace the saved one' if reseller_has_webhook_secret else 'Paste your webhook secret' }}"
          class="input w-full"
          x-model="appReseller.webhookSecret"
        >
        <p class="text-xs text-t-muted mt-1.5">From your own shop's dashboard, under Storefront &rarr; Configure &rarr; Miscellaneous.<br>It verifies that delivery requests really come from your shop.</p>
      </div>

      <p class="text-sm text-error mt-3" x-show="appReseller.ddError" x-cloak x-text="appReseller.ddError"></p>

      <div class="flex items-center gap-2 mt-5">
        <button
          type="button"
          class="relative inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-btn {{ 'border border-theme text-t-primary hover:enabled:bg-t-primary/5' if reseller_dd_enabled else 'bg-accent-500 text-on-accent hover:enabled:bg-accent-600 shadow-btn' }} transition-colors duration-theme disabled:opacity-50 disabled:pointer-events-none"
          @click="appReseller.saveDynamicDelivery({{ 'false' if reseller_dd_enabled else 'true' }})"
          :disabled="appReseller.ddLoading"
        >
          <span :class="appReseller.ddLoading ? 'opacity-0' : 'opacity-100'">{{ 'Disable dynamic delivery' if reseller_dd_enabled else 'Enable dynamic delivery' }}</span>
          <template x-if="appReseller.ddLoading">
            <span class="absolute inset-0 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </span>
          </template>
        </button>
        {% if reseller_has_webhook_secret %}
          <button
            type="button"
            class="relative inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-btn {{ 'bg-accent-500 text-on-accent hover:enabled:bg-accent-600 shadow-btn' if reseller_dd_enabled else 'border border-theme text-t-primary hover:enabled:bg-t-primary/5' }} transition-colors duration-theme disabled:opacity-50 disabled:pointer-events-none"
            @click="appReseller.saveDynamicDelivery({{ 'true' if reseller_dd_enabled else 'false' }})"
            :disabled="appReseller.ddLoading || !appReseller.webhookSecret"
          >
            <span :class="appReseller.ddLoading ? 'opacity-0' : 'opacity-100'">{{ 'reseller.save_secret' | t }}</span>
            <template x-if="appReseller.ddLoading">
              <span class="absolute inset-0 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
              </span>
            </template>
          </button>
        {% endif %}
      </div>

      <div class="mt-5 pt-4 border-t border-theme">
        <div
          class="flex flex-wrap items-center justify-between gap-2"
          x-show="!appReseller.ddRegenConfirm"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
        >
          <div class="min-w-0">
            <p class="text-sm font-medium text-t-primary">{{ 'reseller.regenerate_delivery_urls' | t }}</p>
            <p class="text-xs text-t-muted mt-0.5">{{ "reseller.regenerate_urls_warning" | t }}</p>
          </div>
          <button
            type="button"
            class="shrink-0 inline-flex items-center justify-center px-3 py-1.5 text-xs font-medium rounded-btn border border-error/30 text-error hover:bg-error/[0.06] transition-colors duration-theme"
            @click="appReseller.ddRegenConfirm = true"
          >
            {{ 'common.regenerate' | t }}
          </button>
        </div>

        <div
          class="flex flex-wrap items-center justify-between gap-3"
          x-show="appReseller.ddRegenConfirm"
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
        >
          <p class="text-sm text-t-primary min-w-0">{{ 'reseller.regenerate_urls_confirm' | t }}</p>
          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              class="inline-flex items-center justify-center px-3 py-1.5 text-xs font-medium rounded-btn border border-theme text-t-muted hover:text-t-primary hover:bg-t-primary/5 transition-colors duration-theme"
              @click="appReseller.ddRegenConfirm = false"
              :disabled="appReseller.ddRegenLoading"
            >
              {{ 'common.cancel' | t }}
            </button>
            <button
              type="button"
              class="relative inline-flex items-center justify-center px-3 py-1.5 text-xs font-medium rounded-btn bg-error text-white hover:enabled:opacity-90 transition-opacity duration-theme disabled:opacity-50 disabled:pointer-events-none"
              @click="appReseller.regenerateDynamicToken()"
              :disabled="appReseller.ddRegenLoading"
            >
              <span :class="appReseller.ddRegenLoading ? 'opacity-0' : 'opacity-100'">{{ 'reseller.regenerate_urls_short' | t }}</span>
              <template x-if="appReseller.ddRegenLoading">
                <span class="absolute inset-0 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                </span>
              </template>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
