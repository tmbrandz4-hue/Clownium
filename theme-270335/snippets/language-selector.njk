{% set _lsSize = ls_size if ls_size else 'lg' %}
{% set _lsUp = ls_drop == 'up' %}

{% if languages and languages | length > 1 %}
  <div class="sa-language-selector language-selector relative" x-data="{ languageOpen: false }" @click.outside="languageOpen = false" @keydown.escape.window="languageOpen = false">
    <button
      type="button"
      @click="languageOpen = !languageOpen"
      :aria-expanded="languageOpen"
      aria-haspopup="listbox"
      aria-label="{{ 'header.language' | t }}"
      class="flex items-center font-medium text-t-primary rounded-btn border border-theme hover:bg-t-primary/5 transition-colors duration-theme {{ 'gap-2 h-9 px-3 text-sm' if _lsSize == 'lg' else 'gap-1.5 h-8 px-2.5 text-sm' }}"
    >
      {% if _lsFlags[lang] %}
        <svg viewBox="0 0 640 480" class="w-4 h-3 rounded-[2px] shrink-0" aria-hidden="true">{{ _lsFlags[lang] | safe }}</svg>
      {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-t-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      {% endif %}
      <span class="uppercase">{{ lang }}</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-t-muted transition-transform duration-theme" :class="languageOpen && 'rotate-180'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
    <div
      x-show="languageOpen"
      x-cloak
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 {{ 'translate-y-1' if _lsUp else '-translate-y-1' }}"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-100"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      role="listbox"
      aria-label="{{ 'header.language' | t }}"
      class="absolute right-0 {{ 'bottom-full mb-2' if _lsUp else 'top-full mt-2' }} z-40 w-48 max-h-72 overflow-y-auto hide-scrollbar rounded-card border border-theme bg-surface-raised shadow-modal p-1"
    >
      {% for language in languages %}
        <a
          href="{{ language.url if language.url else '#' }}"
          hreflang="{{ language.code }}"
          onclick="{{ "Cookies.remove('locale', { path: '/' })" if language.code == defaultLang else "Cookies.set('locale', '" + language.code + "', { expires: 365, path: '/' })" }}"
          role="option"
          aria-selected="{{ 'true' if language.active else 'false' }}"
          class="w-full flex items-center gap-2.5 px-2.5 py-2 rounded-input text-sm text-left transition-colors duration-theme {{ 'bg-accent-500/10 text-accent-500 font-medium' if language.active else 'text-t-primary hover:bg-t-primary/5' }}"
        >
          {% if _lsFlags[language.code] %}
            <svg viewBox="0 0 640 480" class="w-5 h-[0.9375rem] rounded-[2px] shrink-0" aria-hidden="true">{{ _lsFlags[language.code] | safe }}</svg>
          {% else %}
            <span class="inline-flex items-center justify-center min-w-9 px-1.5 py-px rounded bg-t-primary/5 text-xs text-t-muted shrink-0 uppercase">{{ language.code }}</span>
          {% endif %}
          <span class="truncate">{{ language.name }}</span>
          {% if language.active %}
            <svg xmlns="http://www.w3.org/2000/svg" class="ml-auto size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}
