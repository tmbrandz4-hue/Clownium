<div
  x-show="appAffiliate.modalPayoutIsOpen"
  x-cloak
  class="sa-affiliate-payout-modal fixed inset-0 z-50 overflow-y-auto"
  aria-labelledby="affiliate-payout-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 text-center">
    <div
      x-show="appAffiliate.modalPayoutIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="appAffiliate.modalPayoutClose()"
      class="fixed inset-0 transition-opacity [background-color:var(--cl-overlay)]"
      aria-hidden="true"
    ></div>

    <div
      x-show="appAffiliate.modalPayoutIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      class="inline-block w-full max-w-lg p-6 my-8 overflow-hidden text-left align-middle transition-all transform border border-theme rounded-card bg-surface-raised shadow-modal text-t-primary"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 id="affiliate-payout-modal-title" class="text-h4 font-heading truncate">
          {{ 'affiliate.request_payout' | t }}
        </h3>

        <button @click="appAffiliate.modalPayoutClose()" class="text-t-muted focus:outline-none hover:text-t-primary transition-colors duration-theme">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      {% if shop.settings.affiliate.payout_instructions %}
        <p class="text-sm text-t-muted mb-4 whitespace-pre-line">{{ shop.settings.affiliate.payout_instructions }}</p>
      {% endif %}

      <form @submit.prevent="appAffiliate.requestPayout()">
        <div class="mb-4">
          <label class="block text-sm font-medium text-t-primary mb-1">
            {{ 'affiliate.amount_usd_placeholder' | t }}
          </label>
          <input
            type="number"
            min="0.01"
            step="0.01"
            x-model="appAffiliate.payoutAmount"
            placeholder="0.00"
            class="input"
            required
          />
          {% if shop.settings.affiliate.payout_min_amount > 0 %}
            <p class="text-xs text-t-muted mt-1">
              Minimum: <span x-text="appCurrency.format({{ shop.settings.affiliate.payout_min_amount }}, 'USD')">{{ formatPrice(shop.settings.affiliate.payout_min_amount, 'USD') }}</span>
            </p>
          {% endif %}
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium text-t-primary mb-1">
            {{ 'affiliate.payout_details' | t }}
          </label>
          <textarea
            rows="3"
            x-model="appAffiliate.payoutDetails"
            placeholder="e.g. your wallet address"
            class="input"
            required
          ></textarea>
        </div>

        <p x-show="appAffiliate.payoutError" class="text-error text-sm mt-2" x-text="appAffiliate.payoutError"></p>

        <button
          type="submit"
          class="mt-4 px-5 py-2.5 rounded-btn w-full flex justify-center items-center gap-2 font-medium bg-accent-500 text-on-accent hover:enabled:bg-accent-600 transition-colors duration-theme shadow-btn disabled:opacity-50 disabled:pointer-events-none"
          :disabled="appAffiliate.payoutLoading"
        >
          {{ 'affiliate.request_payout' | t }}
        </button>
      </form>
    </div>
  </div>
</div>
