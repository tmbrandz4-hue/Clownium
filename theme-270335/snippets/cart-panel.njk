{#
  Cart panel — right drawer, selected by the global `cart_mode` property.
  Mode 'page' renders nothing; the navbar cart button navigates to /cart instead.
  State/logic lives in appCartUi (script.js), shared with the cart page.
#}
{% set _cartMode = global.properties.cart_mode if global.properties.cart_mode else 'drawer-right' %}

{% if _cartMode != 'page' %}
  {# The drawer anchors to the inline end edge, so it mirrors to the left under
     `dir="rtl"`. Tailwind's translate utilities are physical, so the off-screen
     offset is chosen from `dir` — there is no logical `-translate-x-full`. #}
  {% set _panelClass = 'fixed top-0 end-0 h-full w-full max-w-md border-s border-theme' %}
  {% set _enterStart = '-translate-x-full' if dir == 'rtl' else 'translate-x-full' %}
  {% set _enterEnd = 'translate-x-0' %}

  <div
    x-cloak
    x-show="appCartUi.isOpen"
    x-transition:enter="transition ease-out duration-theme"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-theme"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-40"
    style="background-color: var(--cl-overlay);"
    @click="appCartUi.close()"
    aria-hidden="true"
  ></div>

  <aside
    x-cloak
    x-show="appCartUi.isOpen"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="{{ _enterStart }}"
    x-transition:enter-end="{{ _enterEnd }}"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="{{ _enterEnd }}"
    x-transition:leave-end="{{ _enterStart }}"
    class="sa-cart-panel {{ _panelClass }} z-50 bg-surface shadow-modal flex flex-col"
    role="dialog"
    aria-label="{{ 'meta.cart_title' | t }}"
    @keydown.escape.window="appCartUi.close()"
  >
    <div class="flex items-center justify-between border-b border-theme px-5 py-4 shrink-0">
      <h2 class="text-h4 font-heading text-t-primary">
        {{ 'meta.cart_title' | t }} <span class="text-t-muted font-body text-sm" x-show="appCartUi.count > 0" x-text="'(' + appCartUi.count + ')'"></span>
      </h2>
      <button type="button" @click="appCartUi.close()" class="p-1.5 rounded-btn text-t-muted hover:text-t-primary hover:bg-t-primary/5 transition-colors duration-theme" aria-label="{{ 'cart.close' | t }}">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-5 py-4">
      <div x-show="appCartUi.loading" class="py-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="inline-block text-accent-500 size-7 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
      </div>

      <div
        x-show="!appCartUi.loading && appCartUi.fullCart.length === 0"
        x-cloak
        class="py-12 text-center"
      >
        <p class="text-t-muted" x-text="appCartUi.error ? appCartUi.error : '{{ 'cart.empty' | t | jsEscape }}'"></p>
        <a href="{{ '/products' | shopUrl }}" class="inline-flex items-center justify-center mt-4 px-5 py-2.5 text-sm font-medium rounded-btn bg-accent-500 text-on-accent hover:bg-accent-600 transition-colors duration-theme">
          {{ 'products.browse' | t }}
        </a>
      </div>

      <template x-if="appCartUi.messages.length">
        <div class="mb-3 space-y-2">
          <template x-for="message in appCartUi.messages" :key="message">
            <p class="text-sm text-warning border border-theme rounded-input px-3 py-2 bg-warning/5" x-text="message"></p>
          </template>
        </div>
      </template>

      <div class="flex flex-col gap-3" x-show="!appCartUi.loading && appCartUi.fullCart.length > 0" x-cloak>
        <template x-for="(cartItem, index) in appCartUi.fullCart" :key="index">
          <div class="sa-cart-item rounded-card border border-theme bg-surface-raised p-3">
            <div class="flex items-start gap-3">
              <div class="size-14 shrink-0 rounded-input bg-t-primary/5 border border-theme overflow-hidden flex items-center justify-center">
                <template x-if="cartItem.product.image_url">
                  <img :src="cartItem.product.image_url" :alt="cartItem.product.name" class="size-full object-cover" />
                </template>
                <template x-if="!cartItem.product.image_url">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-t-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                </template>
              </div>
              <div class="min-w-0 flex-1">
                <a :href="'/product/' + cartItem.product.path" class="font-medium text-t-primary text-sm truncate block hover:text-accent-500 transition-colors duration-theme" x-text="cartItem.product.name"></a>
                <p class="text-xs text-t-muted truncate" x-text="cartItem.variant.name"></p>
                <template x-if="cartItem.addons && cartItem.addons.length">
                  <p class="text-xs text-t-muted mt-0.5" x-text="'+ ' + cartItem.addons.map(a => a.product.name).join(', ')"></p>
                </template>
              </div>
              <div class="text-end shrink-0">
                <p class="font-semibold text-t-primary text-sm" x-text="appCurrency.format(appCartUi.getItemTotal(cartItem), cartItem.product.currency)"></p>
                <p x-cloak x-show="appCartUi.getAppliedVolumeDiscount(cartItem)" class="text-xs text-t-muted line-through" x-text="appCurrency.format(appCartUi.getItemBaseTotal(cartItem), cartItem.product.currency)"></p>
              </div>
            </div>

            <div class="flex items-center justify-between gap-3 mt-3">
              <div class="input-stepper">
                <button type="button" @click="appCartUi.changeQuantity(index, cartItem.quantity - 1)" class="!w-8" aria-label="{{ 'product.decrease_quantity' | t }}">−</button>
                <span class="min-w-[2.25rem] flex items-center justify-center" x-text="cartItem.quantity"></span>
                <button type="button" @click="appCartUi.changeQuantity(index, cartItem.quantity + 1)" class="!w-8" aria-label="{{ 'product.increase_quantity' | t }}">+</button>
              </div>
              <button type="button" @click="appCartUi.removeItem(index)" class="text-sm text-t-muted hover:text-error transition-colors duration-theme">
                {{ 'common.remove' | t }}
              </button>
            </div>
          </div>
        </template>
      </div>

      <p x-show="appCartUi.error && appCartUi.fullCart.length > 0" x-cloak x-text="appCartUi.error" class="mt-4 text-sm text-error"></p>
    </div>

    <div class="border-t border-theme px-5 py-4 space-y-3 shrink-0" x-show="appCartUi.fullCart.length > 0" x-cloak>
      <div class="space-y-1">
        <div class="flex items-center justify-between">
          <span class="text-t-muted text-sm">{{ 'common.subtotal' | t }}</span>
          <span class="font-semibold text-t-primary" :class="appCartUi.discountTotal > 0 ? 'text-sm' : 'text-lg'" x-text="appCurrency.format(appCartUi.subtotal, appCartUi.currency)"></span>
        </div>
        <template x-for="deal in appCartUi.quantityDeals" :key="'qd-' + deal.id">
          <div x-show="appCartUi.getQuantityDealDiscount(deal) > 0" class="flex items-center justify-between">
            <span class="text-sm text-t-muted" x-text="deal.name"></span>
            <span class="text-sm text-success" x-text="'-' + appCurrency.format(appCartUi.getQuantityDealDiscount(deal), appCartUi.currency)"></span>
          </div>
        </template>
        <template x-for="offer in appCartUi.bundleOffers" :key="'bo-' + offer.id">
          <div x-show="appCartUi.getBundleDiscount(offer) > 0" class="flex items-center justify-between">
            <span class="text-sm text-t-muted" x-text="offer.name"></span>
            <span class="text-sm text-success" x-text="'-' + appCurrency.format(appCartUi.getBundleDiscount(offer), appCartUi.currency)"></span>
          </div>
        </template>
        <div x-cloak x-show="appCartUi.discountTotal > 0" class="flex items-center justify-between border-t border-theme pt-2 mt-2">
          <span class="text-t-muted text-sm">{{ 'common.total' | t }}</span>
          <span class="text-lg font-semibold text-t-primary" x-text="appCurrency.format(appCartUi.total, appCartUi.currency)"></span>
        </div>
      </div>
      <button
        type="button"
        @click="appCartUi.checkout()"
        :disabled="appCartUi.submitting"
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 font-medium rounded-btn bg-accent-500 text-on-accent hover:bg-accent-600 transition-colors duration-theme disabled:opacity-50 shadow-btn"
      >
        <span x-text="appCartUi.submitting ? '{{ 'cart.processing' | t | jsEscape }}' : '{{ 'cart.checkout' | t | jsEscape }}'"></span>
      </button>
      <div class="flex items-center justify-between text-sm">
        <a href="{{ '/cart' | shopUrl }}" class="text-t-muted hover:text-t-primary transition-colors duration-theme">{{ 'cart.view_page' | t }}</a>
        <button type="button" @click="appCartUi.clear()" class="text-t-muted hover:text-error transition-colors duration-theme">{{ 'cart.clear' | t }}</button>
      </div>
    </div>
  </aside>
{% endif %}
