{# Inline search field; submits to the products page keyword filter. #}
<form action="{{ '/products' | shopUrl }}" method="GET" class="sa-searchbar w-full max-w-md {{ searchbar_class if searchbar_class else '' }}">
  <div class="relative">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 absolute left-3 top-1/2 -translate-y-1/2 text-t-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input
      type="text"
      name="filters[keyword]"
      placeholder="{{ searchbar_placeholder if searchbar_placeholder else 'Search products' }}"
      class="input h-10 pl-9"
    />
  </div>
</form>
