{#
  Search modal. Opens on window event 'search:open'.
  Filters the globally available items client-side; submitting goes to
  /products?filters[keyword]= for full server-side search.
#}
<div class="sa-search-modal" x-data="searchModal" x-on:search:open.window="openModal()" x-on:keydown.escape.window="closeModal()">
  <div
    x-cloak
    x-show="isOpen"
    x-transition:enter="transition ease-out duration-theme"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-40"
    style="background-color: var(--cl-overlay);"
    @click="closeModal()"
    aria-hidden="true"
  ></div>

  <div
    x-cloak
    x-show="isOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 scale-100"
    x-transition:leave-end="opacity-0 scale-95"
    class="fixed top-[10vh] left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-xl z-50 rounded-card border border-theme bg-surface shadow-modal"
    role="dialog"
    aria-label="{{ 'products.search_short_placeholder' | t }}"
  >
    <form @submit.prevent="submit()" class="flex items-center gap-3 px-4 py-3 border-b border-theme">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-t-muted shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        x-ref="searchInput"
        x-model="term"
        @input="filter()"
        type="text"
        placeholder="{{ 'products.search_placeholder' | t }}"
        class="flex-1 bg-transparent text-t-primary placeholder:text-t-muted focus:outline-none"
      />
      <button type="button" @click="closeModal()" class="text-xs text-t-muted border border-theme rounded-badge px-2 py-1">esc</button>
    </form>

    <div class="max-h-[50vh] overflow-y-auto p-2">
      {# sortedItems mixes groups and standalone products; flatten to a plain
         product list (group entries carry their products nested). #}
      {% set _searchProducts = [] %}
      {% for item in sortedItems %}
        {% if item.type == 'group' %}
          {% for p in item.products %}
            {% if _searchProducts.push(p) %}{% endif %}
          {% endfor %}
        {% elif not item.group_id %}
          {% if _searchProducts.push(item) %}{% endif %}
        {% endif %}
      {% endfor %}

      {% if _searchProducts | length %}
        {% for item in _searchProducts %}
          <a
            href="{{ ('/product/' + item.path) | shopUrl }}"
            data-search="{{ item.name }}"
            style="display: none;"
            class="flex items-center gap-3 px-3 py-2.5 rounded-input hover:bg-t-primary/5 transition-colors duration-theme"
          >
            <div class="size-10 shrink-0 rounded-input bg-t-primary/5 border border-theme overflow-hidden flex items-center justify-center">
              {% if item.image_urls | length %}
                <img src="{{ item.image_urls[0] }}" alt="{{ item.name }}" class="size-full object-cover" loading="lazy" />
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-t-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              {% endif %}
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-t-primary truncate">{{ item.name }}</p>
            </div>
            <span class="text-sm text-t-muted shrink-0" x-text="appCurrency.format({{ item.min_price }}, '{{ item.currency }}')"></span>
          </a>
        {% endfor %}
      {% endif %}

      <p x-show="term.trim() !== '' && visibleCount === 0" x-cloak class="px-3 py-6 text-center text-sm text-t-muted">
        No matches here — press Enter to search everything.
      </p>
      <p x-show="term.trim() === ''" class="px-3 py-6 text-center text-sm text-t-muted">
        {{ 'products.search_hint' | t }}
      </p>
    </div>
  </div>
</div>
